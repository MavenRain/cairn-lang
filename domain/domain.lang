-- The domain file. sealed-lang S2 (R21) removed the kit sample (ported in
-- orbit-lang S2). The DAO prelude comes in S7.
-- Each family, constructor, field and def name here becomes a core name
-- (rule R4). Only this file can declare a family (rule R1).

-- Kan library (ported from sealed-lang, R6 (a)): transport, subst, J and the
-- J rule as a path (JRefl, sealed-lang O11), all by transp.
def transport : (X : Type 0) -> (Y : Type 0) -> Path (Type 0) X Y -> X -> Y :=
  fun (X : Type 0) => fun (Y : Type 0) => fun (p : Path (Type 0) X Y) => fun (a : X) => transp (fun (i : I) => p @ i) i0 a
def subst : (A : Type 0) -> (B : A -> Type 0) -> (x : A) -> (y : A) -> Path A x y -> B x -> B y :=
  fun (A : Type 0) => fun (B : A -> Type 0) => fun (x : A) => fun (y : A) => fun (p : Path A x y) => fun (b : B x) =>
    transp (fun (i : I) => B (p @ i)) i0 b
def J : (A : Type 0) -> (x : A) -> (P : (y : A) -> Path A x y -> Type 0) -> P x refl -> (y : A) -> (p : Path A x y) -> P y p :=
  fun (A : Type 0) => fun (x : A) => fun (P : (y : A) -> Path A x y -> Type 0) => fun (d : P x refl) => fun (y : A) => fun (p : Path A x y) =>
    transp (fun (i : I) => P (p @ i) (fun (j : I) => p @ (i /\ j))) i0 d
def JRefl : (A : Type 0) -> (x : A) -> (P : (y : A) -> Path A x y -> Type 0) -> (d : P x refl) -> Path (P x refl) (J A x P d x refl) d :=
  fun (A : Type 0) => fun (x : A) => fun (P : (y : A) -> Path A x y -> Type 0) => fun (d : P x refl) =>
    fun (i : I) => transp (fun (_ : I) => P x refl) i d
-- Path composition (S2b, R2 (a)): trans by hcomp, with the tube x on ~j
-- and q on j, and the base p.
def trans : (A : Type 0) -> (x : A) -> (y : A) -> (z : A) -> Path A x y -> Path A y z -> Path A x z :=
  fun (A : Type 0) => fun (x : A) => fun (y : A) => fun (z : A) => fun (p : Path A x y) => fun (q : Path A y z) =>
    fun (j : I) => hcomp A (~j \/ j) (fun (i : I) => [ ~j -> x, j -> q @ i ]) (p @ j)
-- Propositions and sets (S4b): the squash1 fold case has the type
-- isProp RES, the squash0 fold case the type isSet RES.
def isProp : (A : Type 0) -> Type 0 :=
  fun (A : Type 0) => (x : A) -> (y : A) -> Path A x y
def isSet : (A : Type 0) -> Type 0 :=
  fun (A : Type 0) => (x : A) -> (y : A) -> isProp (Path A x y)
-- The function set (S5, Q-S5-6 (b)): when B is a set, A -> B is a set,
-- point by point. The carriers natIsSet, u256IsSet and flagIsSet are
-- trusted constants (docs/VALIDATION.md).
def isSetFun : (A : Type 0) -> (B : Type 0) -> isSet B -> isSet (A -> B) :=
  fun (A : Type 0) (B : Type 0) (s : isSet B) (f : A -> B) (g : A -> B) (p : Path (A -> B) f g) (q : Path (A -> B) f g) =>
    fun (i : I) => fun (j : I) => fun (a : A) => (s (f a) (g a) (fun (k : I) => (p @ k) a) (fun (k : I) => (q @ k) a) @ i) @ j

-- The circle, a higher inductive family (S4a, R1 (a)). The path
-- constructor loop goes from base to base.
family S1 := base | loop (i : I) [ ~i -> base, i -> base ]
-- The propositional truncation (S4b, R5 (a)): squash1 is a path between
-- any two points, so the squash1 fold case has the type isProp RES. A
-- field name is a core name (rule R4), so the names have a family prefix.
family Trunc1 (A : Type 0) := trunc1 (truncOf : A) | squash1 (squashFrom : Trunc1 A) (squashTo : Trunc1 A) (i : I) [ ~i -> squashFrom, i -> squashTo ]
-- The set truncation (S4c, R5 (a)): squash0 is a square between any two
-- paths with the same ends, so the squash0 fold case has the type isSet
-- RES (R8 (a)). The case binds the folded ends and the folded paths.
family Trunc0 (A : Type 0) := trunc0 (trunc0Of : A) | squash0 (squash0From : Trunc0 A) (squash0To : Trunc0 A) (squash0Left : Path (Trunc0 A) squash0From squash0To) (squash0Right : Path (Trunc0 A) squash0From squash0To) (i : I) (j : I) [ ~i -> squash0Left @ j, i -> squash0Right @ j, ~j -> squash0From, j -> squash0To ]
-- The set quotient Quot went in S3 (rule R1: its relation parameter is a
-- value parameter, so it is not a cell signature). The quotients of the
-- DAO are families with no parameter: Orbit, Parity and OrbitN.
-- The size index (S6, O24, USER ruling S6): a domain family, so Nat
-- stays internal.
family Size := sz0 | szS (szPred : Size)
-- The stream comonad (S4, O28): the cofree comonad of the cocell
-- signature with the observation sHead and the cofield sTail. The checker
-- elaborates it (choice (ii)) to the positions Stream.pos, Stream A :=
-- Stream.pos -> A, the destructors sHead and sTail, the walk Stream.walk,
-- the corecursor sCorec and the bisimulation principle StreamBisim.
cofamily Stream (A : Type 0) := sCorec (sHead : A) (sTail : Stream A)
-- Extend and duplicate: sExtend A B f is the corecursor at the seed type
-- Stream A, with the observation f and the step sTail A.
def sExtend : (A : Type 0) -> (B : Type 0) -> (Stream A -> B) -> Stream A -> Stream B :=
  fun (A : Type 0) => fun (B : Type 0) => fun (f : Stream A -> B) => sCorec B (Stream A) f (sTail A)
def sDuplicate : (A : Type 0) -> Stream A -> Stream (Stream A) :=
  fun (A : Type 0) => sExtend A (Stream A) (fun (x : Stream A) => x)
-- The parity quotient of Size (S3, design C 2b, USER ruling Q-S3-8 (a)):
-- sizeEven s is sz0 for an even s and szS sz0 for an odd s, and parityEq
-- is a path from parityOf a to parityOf b when a and b have the same
-- parity. The relation is in the field type, so Parity has no parameter.
-- paritySquash has the squash0 shape, so its fold case has the type isSet
-- RES.
def sizeFlip : Size -> Size := fun (s : Size) => elim (fun (t : Size) => Size) (szS sz0) (fun (k : Size) (ih : Size) => sz0) s
def sizeEven : Size -> Size := fun (s : Size) => fold sz0 (fun (r : Size) => sizeFlip r) s
family Parity := parityOf (parityAt : Size)
  | parityEq (parityA : Size) (parityB : Size) (parityR : Path Size (sizeEven parityA) (sizeEven parityB)) (i : I) [ ~i -> parityOf parityA, i -> parityOf parityB ]
  | paritySquash (parityFrom : Parity) (parityTo : Parity) (parityLeft : Path Parity parityFrom parityTo) (parityRight : Path Parity parityFrom parityTo) (i : I) (j : I)
    [ ~i -> parityLeft @ j, i -> parityRight @ j, ~j -> parityFrom, j -> parityTo ]
-- The empty family (S10 B1, USER ruling Q-S10-9 (a)): one constructor and
-- no base case, so no closed value. The parser needs a constructor, so
-- Empty is not a family with no constructor (the Q-S10-4 (a) probe).
family Empty := emptyLoop (emptyOf : Empty)
-- The bag (S3, design C section 3, rule R1): the free commutative monoid
-- on A. bagOf is the generator, bagUnit the unit and bagOp the operation;
-- bagAssoc, bagComm and bagUnitL are the monoid paths (the right unit
-- follows from bagComm), and bagSquash in the form of Trunc0 squash0
-- makes it a set. A occurs only in the generator field. It was an
-- indexed HIT of lists up to a swap (S6, O20): a Size field and an
-- indexed bagOp have no comm path.
family Bag (A : Type 0) := bagOf (bagGen : A)
  | bagUnit
  | bagOp (opLeft : Bag A) (opRight : Bag A)
  | bagAssoc (assocX : Bag A) (assocY : Bag A) (assocZ : Bag A) (i : I)
    [ ~i -> bagOp A (bagOp A assocX assocY) assocZ, i -> bagOp A assocX (bagOp A assocY assocZ) ]
  | bagComm (commX : Bag A) (commY : Bag A) (i : I)
    [ ~i -> bagOp A commX commY, i -> bagOp A commY commX ]
  | bagUnitL (unitX : Bag A) (i : I)
    [ ~i -> bagOp A (bagUnit A) unitX, i -> unitX ]
  | bagSquash (bagFrom : Bag A) (bagTo : Bag A) (bagLeft : Path (Bag A) bagFrom bagTo) (bagRight : Path (Bag A) bagFrom bagTo) (i : I) (j : I)
    [ ~i -> bagLeft @ j, i -> bagRight @ j, ~j -> bagFrom, j -> bagTo ]
-- The free monoid (S3, USER ruling Q-S3-5 (a), rule R1): the cell monad
-- of the monoid signature, with the generator fmEta and a set squash. The
-- cons list List is kit only (the host ABI); a guest List gives REFUSE_CELL,
-- and a guest program uses FreeMon. The bind is the fold (fmFold).
family FreeMon (A : Type 0) := fmEta (fmEtaOf : A)
  | fmUnit
  | fmMul (fmLeft : FreeMon A) (fmRight : FreeMon A)
  | fmAssoc (fmAssocX : FreeMon A) (fmAssocY : FreeMon A) (fmAssocZ : FreeMon A) (i : I)
    [ ~i -> fmMul A (fmMul A fmAssocX fmAssocY) fmAssocZ, i -> fmMul A fmAssocX (fmMul A fmAssocY fmAssocZ) ]
  | fmUnitL (fmUnitLOf : FreeMon A) (i : I)
    [ ~i -> fmMul A (fmUnit A) fmUnitLOf, i -> fmUnitLOf ]
  | fmUnitR (fmUnitROf : FreeMon A) (i : I)
    [ ~i -> fmMul A fmUnitROf (fmUnit A), i -> fmUnitROf ]
  | fmSquash (fmFrom : FreeMon A) (fmTo : FreeMon A) (fmPathL : Path (FreeMon A) fmFrom fmTo) (fmPathR : Path (FreeMon A) fmFrom fmTo) (i : I) (j : I)
    [ ~i -> fmPathL @ j, i -> fmPathR @ j, ~j -> fmFrom, j -> fmTo ]
def fmCons : (A : Type 0) -> A -> FreeMon A -> FreeMon A :=
  fun (A : Type 0) (a : A) (xs : FreeMon A) => fmMul A (fmEta A a) xs
def fmIsSet : (A : Type 0) -> isSet (FreeMon A) :=
  fun (A : Type 0) (x : FreeMon A) (y : FreeMon A) (p : Path (FreeMon A) x y) (q : Path (FreeMon A) x y) => fun (i : I) => fun (j : I) => fmSquash A x y p q i j
-- The universal property: a map from A into a monoid M that is a set
-- extends to FreeMon A. The fold cases are the laws of M.
def fmFold : (A : Type 0) -> (M : Type 0) -> isSet M -> (e : M) -> (op : M -> M -> M) -> ((x : M) -> (y : M) -> (z : M) -> Path M (op (op x y) z) (op x (op y z))) -> ((x : M) -> Path M (op e x) x) -> ((x : M) -> Path M (op x e) x) -> (A -> M) -> FreeMon A -> M :=
  fun (A : Type 0) (M : Type 0) (s : isSet M) (e : M) (op : M -> M -> M) (assoc : (x : M) -> (y : M) -> (z : M) -> Path M (op (op x y) z) (op x (op y z))) (unitL : (x : M) -> Path M (op e x) x) (unitR : (x : M) -> Path M (op x e) x) (f : A -> M) (t : FreeMon A) =>
    fold (fun (a : A) => f a) e (fun (x : M) (y : M) => op x y)
      (fun (x : M) (y : M) (z : M) => fun (i : I) => assoc x y z @ i)
      (fun (x : M) => fun (i : I) => unitL x @ i)
      (fun (x : M) => fun (i : I) => unitR x @ i)
      (fun (x : M) (y : M) (p : Path M x y) (q : Path M x y) => fun (i : I) => fun (j : I) => (s x y p q @ i) @ j) t
def fmBind : (A : Type 0) -> (B : Type 0) -> (A -> FreeMon B) -> FreeMon A -> FreeMon B :=
  fun (A : Type 0) (B : Type 0) (k : A -> FreeMon B) => fmFold A (FreeMon B) (fmIsSet B) (fmUnit B) (fmMul B)
    (fun (x : FreeMon B) (y : FreeMon B) (z : FreeMon B) => fun (i : I) => fmAssoc B x y z i)
    (fun (x : FreeMon B) => fun (i : I) => fmUnitL B x i)
    (fun (x : FreeMon B) => fun (i : I) => fmUnitR B x i) k
def fmMap : (A : Type 0) -> (B : Type 0) -> (A -> B) -> FreeMon A -> FreeMon B :=
  fun (A : Type 0) (B : Type 0) (f : A -> B) => fmBind A B (fun (a : A) => fmEta B (f a))
-- The trace position (S3, USER ruling Q-S3-3 (a)): a position is an op
-- count.
def OpPos : Type 0 := Nat
-- The folds of a trace into a set B (S5, Q-S5-6 (b)): fmChain runs from
-- the first op to the last, fmRun from the last op to the first. The
-- monoid is the endomaps of B, a set by isSetFun, and its laws are refl.
def endoThen : (B : Type 0) -> (B -> B) -> (B -> B) -> B -> B :=
  fun (B : Type 0) (g : B -> B) (h : B -> B) (d : B) => h (g d)
def fmChain : (A : Type 0) -> (B : Type 0) -> isSet B -> (B -> A -> B) -> B -> FreeMon A -> B :=
  fun (A : Type 0) (B : Type 0) (s : isSet B) (step : B -> A -> B) (b0 : B) (r : FreeMon A) =>
    fmFold A (B -> B) (isSetFun B B s) (fun (d : B) => d) (endoThen B)
      (fun (x : B -> B) (y : B -> B) (z : B -> B) => refl)
      (fun (x : B -> B) => refl)
      (fun (x : B -> B) => refl)
      (fun (a : A) (d : B) => step d a) r b0
def fmRun : (A : Type 0) -> (B : Type 0) -> isSet B -> (A -> B -> B) -> B -> FreeMon A -> B :=
  fun (A : Type 0) (B : Type 0) (s : isSet B) (step : A -> B -> B) (b0 : B) (r : FreeMon A) =>
    fmFold A (B -> B) (isSetFun B B s) (fun (d : B) => d) (fun (g : B -> B) (h : B -> B) => endoThen B h g)
      (fun (x : B -> B) (y : B -> B) (z : B -> B) => refl)
      (fun (x : B -> B) => refl)
      (fun (x : B -> B) => refl)
      step r b0
-- len A r, the op count of the trace r (S5, O16): a fold, not a C builtin.
def len : (A : Type 0) -> FreeMon A -> Nat :=
  fun (A : Type 0) (r : FreeMon A) => fmChain A Nat natIsSet (fun (n : Nat) (a : A) => natAdd n 1) 0 r
-- The record (S5, Part R, Q-S5-1 .. Q-S5-5 (a)): a trace of entries, each
-- entry a digest. A guest names Digest, never U256. snoc puts an entry at
-- the end.
def Digest : Type 0 := U256
def Entry : Type 0 := Digest
def Record : Type 0 := FreeMon Entry
def snoc : Entry -> Record -> Record :=
  fun (e : Entry) (r : Record) => fmMul Entry r (fmEta Entry e)
-- The hash chain (Q-S5-3 (a), Q-S5-4 (a)): the tags are the ASCII bytes of
-- "cairn-genesis" and "cairn-append" as a big-endian U256, as the bLSAG
-- tag "cairn" (O5). H3 nests two hash calls. chainFrom d r runs the chain
-- from d over the entries of r, and head r runs it from the genesis digest.
def tagGenesis : Digest := 0x636169726e2d67656e65736973u
def tagAppend : Digest := 0x636169726e2d617070656e64u
def H3 : Digest -> Digest -> Entry -> Digest :=
  fun (t : Digest) (d : Digest) (e : Entry) => hash (hash t d) e
def chainFrom : Digest -> Record -> Digest :=
  fun (d : Digest) (r : Record) => fmChain Entry Digest u256IsSet (fun (h : Digest) (x : Entry) => H3 tagAppend h x) d r
def head : Record -> Digest :=
  fun (r : Record) => chainFrom (hash tagGenesis 0u) r
-- The guest names of the L2 successor and the L5 result (Q-S5-10 (a)).
def opSucc : OpPos -> OpPos := fun (n : OpPos) => natAdd n 1
def Verdict : Type 0 := Flag
def verdictYes : Verdict := flagYes
-- verify e r (Q-S5-9 (a)): the position of the first entry e of r, or
-- none. The fold runs from the last entry to the first with a found code:
-- 0 is none, j + 1 is the position j (foundAt).
def foundAt : Nat -> Option OpPos :=
  fun (f : Nat) => flagIf (natEq f 0) none (some (natSub f 1))
def verify : Entry -> Record -> Option OpPos :=
  fun (e : Entry) (r : Record) =>
    foundAt (fmRun Entry Nat natIsSet (fun (x : Entry) (f : Nat) => flagIf (u256Eq x e) 1 (flagIf (natEq f 0) 0 (natAdd f 1))) 0 r)
-- prefix r s (Q-S5-5 (a)): s is r and then a rest t, by a path.
def prefix : Record -> Record -> Type 0 :=
  fun (r : Record) (s : Record) => Sigma (t : Record) (Path Record (fmMul Entry r t) s)
-- An inclusion proof (Q-S5-5 (a)): the head before position p and the
-- entries from p to the end. recTake p r keeps the entries before p and
-- recDrop p r the entries from p. verifyAt e inc h is verdictYes when the
-- first entry of the suffix is e and the chain from inclBefore over the
-- suffix ends at h.
family Inclusion := inclusionOf (inclBefore : Digest) (inclSuffix : Record)
def recTake : OpPos -> Record -> Record :=
  fun (p : OpPos) (r : Record) => fmRun Entry (Nat -> Record) (isSetFun Nat Record (fmIsSet Entry))
    (fun (x : Entry) (b : Nat -> Record) (n : Nat) => flagIf (natLe p n) (fmUnit Entry) (fmCons Entry x (b (natAdd n 1))))
    (fun (n : Nat) => fmUnit Entry) r 0
def recDrop : OpPos -> Record -> Record :=
  fun (p : OpPos) (r : Record) => fmRun Entry (Nat -> Record) (isSetFun Nat Record (fmIsSet Entry))
    (fun (x : Entry) (b : Nat -> Record) (n : Nat) => flagIf (natLe p n) (fmCons Entry x (b (natAdd n 1))) (b (natAdd n 1)))
    (fun (n : Nat) => fmUnit Entry) r 0
def inclusion : OpPos -> Record -> Inclusion :=
  fun (p : OpPos) (r : Record) => inclusionOf (head (recTake p r)) (recDrop p r)
def verifyAt : Entry -> Inclusion -> Digest -> Verdict :=
  fun (e : Entry) (inc : Inclusion) (h : Digest) =>
    elim (fun (u : Inclusion) => Flag)
      (fun (b : Digest) (s : Record) => flagIf (fmRun Entry Flag flagIsSet (fun (x : Entry) (f : Flag) => u256Eq x e) flagNo s) (u256Eq (chainFrom b s) h) flagNo) inc
-- The encrypted values (S5, USER rulings Q3 (a) and Q-S5-1 .. Q-S5-3 (a),
-- rule O7): the identity cell monad with a sealed eliminator. A guest elim,
-- fold or projection of Enc, or a use of a law def (decrypt, observe),
-- outside a Trunc1 argument makes a guest def law-only, and a law-only
-- guest def must have a law type (a Path or Trunc1 codomain), else
-- REFUSE_LAW. encBind is the fold, encMap and encOp2 are binds (the op*
-- homomorphisms), decrypt is the counit, observe is decrypt under Trunc1.
sealed family Enc (A : Type 0) := encEta (encOf : A)
def encBind : (A : Type 0) -> (B : Type 0) -> Enc A -> (A -> Enc B) -> Enc B :=
  fun (A : Type 0) (B : Type 0) (c : Enc A) (f : A -> Enc B) => fold (fun (a : A) => f a) c
def encMap : (A : Type 0) -> (B : Type 0) -> (A -> B) -> Enc A -> Enc B :=
  fun (A : Type 0) (B : Type 0) (f : A -> B) (c : Enc A) => encBind A B c (fun (a : A) => encEta B (f a))
def encOp2 : (A : Type 0) -> (B : Type 0) -> (C : Type 0) -> (A -> B -> C) -> Enc A -> Enc B -> Enc C :=
  fun (A : Type 0) (B : Type 0) (C : Type 0) (op : A -> B -> C) (c1 : Enc A) (c2 : Enc B) =>
  encBind A C c1 (fun (a : A) => encBind B C c2 (fun (b : B) => encEta C (op a b)))
law def decrypt : (A : Type 0) -> Enc A -> A :=
  fun (A : Type 0) (c : Enc A) => fold (fun (a : A) => a) c
law def observe : (A : Type 0) -> Enc A -> Trunc1 A :=
  fun (A : Type 0) (c : Enc A) => trunc1 A (decrypt A c)
-- Quorum (S6, rule O7): the public part of a threshold opening, t of n.
family Quorum := quorum (quorumT : Size) (quorumN : Size)
law def open : (A : Type 0) -> Quorum -> Enc A -> A :=
  fun (A : Type 0) (q : Quorum) (c : Enc A) => decrypt A c
-- ZKProof and Transcript (S7, Q-S7-1 .. Q-S7-3 (a), rule O7). A proof of W
-- is the truncation of W, and zero knowledge is the squash1 cell. ZKProof
-- is a def, not a family. The O7 walk skips the argument of ZKProof, as it
-- skips the argument of Trunc1. In the ideal model a Transcript holds its
-- witness, as an Enc holds its plaintext. verified is a law def, as
-- observe. A failed check is a host refusal or a chain revert, so the
-- codomain is not an Option.
def ZKProof : Type 0 -> Type 0 := fun (W : Type 0) => Trunc1 W
sealed family Transcript (W : Type 0) := transcript (transcriptOf : W)
law def verified : (W : Type 0) -> Transcript W -> ZKProof W :=
  fun (W : Type 0) (t : Transcript W) => trunc1 W (elim (fun (u : Transcript W) => W) (fun (w : W) => w) t)
-- The positions of a bag (S7 B3, Q4): Pos n has n values, the first
-- position at each szS and a lift of each position of the tail. No
-- constructor gives Pos sz0. A domain family, so Fin stays internal (O23).
family Pos : Size -> Type 0 := posFirst (firstSize : Size) : Pos (szS firstSize)
  | posNext (nextSize : Size) (nextPos : Pos nextSize) : Pos (szS nextSize)
-- The words of adjacent swaps (S7 B3, Q5): wordSwap applies the rest,
-- then swaps the first two positions, and wordLift applies the inner
-- word to the tail, then the rest. The orbits of a word action are the
-- orbits of the symmetric group.
family Word : Size -> Type 0 := wordNil (nilSize : Size) : Word nilSize
  | wordSwap (wordAt : Size) (wordRest : Word (szS (szS wordAt))) : Word (szS (szS wordAt))
  | wordLift (liftSize : Size) (liftInner : Word liftSize) (liftRest : Word (szS liftSize)) : Word (szS liftSize)
-- The choice bags and the orbits at each size (S3, design C section 3,
-- USER ruling Q-S3-6 (a)). ChoiceBag is the old cons Bag at the choice
-- type Sum Unit Unit, and OrbitN n is the quotient of the configurations
-- Pos n -> Sum Unit Unit by the word action. The two families have no
-- parameter, so they are not type constructors (rule R1). sizePred gives
-- the index of a tail, consP puts a choice in front of a configuration,
-- swapFront swaps the first two positions and actW is the word action.
def sizePred : Size -> Size := fun (s : Size) => elim (fun (t : Size) => Size) sz0 (fun (k : Size) (ih : Size) => k) s
def consP : (n : Size) -> Sum Unit Unit -> (Pos n -> Sum Unit Unit) -> Pos (szS n) -> Sum Unit Unit :=
  fun (n : Size) (a : Sum Unit Unit) (t : Pos n -> Sum Unit Unit) (p : Pos (szS n)) =>
    (elim (fun (k : Size) (q : Pos k) => Sum Unit Unit -> (Pos (sizePred k) -> Sum Unit Unit) -> Sum Unit Unit)
      (fun (m : Size) => fun (b : Sum Unit Unit) (u : Pos m -> Sum Unit Unit) => b)
      (fun (m : Size) (q : Pos m) (ih : Sum Unit Unit -> (Pos (sizePred m) -> Sum Unit Unit) -> Sum Unit Unit) => fun (b : Sum Unit Unit) (u : Pos m -> Sum Unit Unit) => u q) p) a t
def swapFront : (m : Size) -> (Pos (szS (szS m)) -> Sum Unit Unit) -> Pos (szS (szS m)) -> Sum Unit Unit :=
  fun (m : Size) (c : Pos (szS (szS m)) -> Sum Unit Unit) =>
    consP (szS m) (c (posNext (szS m) (posFirst m))) (consP m (c (posFirst (szS m))) (fun (p : Pos m) => c (posNext (szS m) (posNext m p))))
def actW : (n : Size) -> Word n -> (Pos n -> Sum Unit Unit) -> Pos n -> Sum Unit Unit :=
  fun (n : Size) (w : Word n) => elim (fun (k : Size) (v : Word k) => (Pos k -> Sum Unit Unit) -> Pos k -> Sum Unit Unit)
    (fun (k : Size) => fun (d : Pos k -> Sum Unit Unit) => d)
    (fun (m : Size) (v : Word (szS (szS m))) (ih : (Pos (szS (szS m)) -> Sum Unit Unit) -> Pos (szS (szS m)) -> Sum Unit Unit) =>
      fun (d : Pos (szS (szS m)) -> Sum Unit Unit) => swapFront m (ih d))
    (fun (m : Size) (u : Word m) (ihu : (Pos m -> Sum Unit Unit) -> Pos m -> Sum Unit Unit) (v : Word (szS m)) (ihv : (Pos (szS m) -> Sum Unit Unit) -> Pos (szS m) -> Sum Unit Unit) =>
      fun (d : Pos (szS m) -> Sum Unit Unit) => ihv (consP m (d (posFirst m)) (ihu (fun (p : Pos m) => d (posNext m p))))) w
family ChoiceBag : Size -> Type 0 := choiceNil : ChoiceBag sz0
  | choiceCons (cbSize : Size) (cbHead : Sum Unit Unit) (cbTail : ChoiceBag cbSize) : ChoiceBag (szS cbSize)
  | choiceSwap (cbSwapSize : Size) (cbFirst : Sum Unit Unit) (cbSecond : Sum Unit Unit) (cbSwapTail : ChoiceBag cbSwapSize) (i : I) : ChoiceBag (szS (szS cbSwapSize))
    [ ~i -> choiceCons (szS cbSwapSize) cbFirst (choiceCons cbSwapSize cbSecond cbSwapTail), i -> choiceCons (szS cbSwapSize) cbSecond (choiceCons cbSwapSize cbFirst cbSwapTail) ]
  | choiceSquash (cbSquashSize : Size) (cbFrom : ChoiceBag cbSquashSize) (cbTo : ChoiceBag cbSquashSize) (cbLeft : Path (ChoiceBag cbSquashSize) cbFrom cbTo) (cbRight : Path (ChoiceBag cbSquashSize) cbFrom cbTo) (i : I) (j : I) : ChoiceBag cbSquashSize
    [ ~i -> cbLeft @ j, i -> cbRight @ j, ~j -> cbFrom, j -> cbTo ]
family OrbitN : Size -> Type 0 := orbitNOf (onSize : Size) (onOf : Pos onSize -> Sum Unit Unit) : OrbitN onSize
  | orbitNEq (onEqSize : Size) (onA : Pos onEqSize -> Sum Unit Unit) (onB : Pos onEqSize -> Sum Unit Unit) (onR : Sigma (w : Word onEqSize) (Path (Pos onEqSize -> Sum Unit Unit) (actW onEqSize w onB) onA)) (i : I) : OrbitN onEqSize
    [ ~i -> orbitNOf onEqSize onA, i -> orbitNOf onEqSize onB ]
  | orbitNSquash (onSqSize : Size) (onFrom : OrbitN onSqSize) (onTo : OrbitN onSqSize) (onLeft : Path (OrbitN onSqSize) onFrom onTo) (onRight : Path (OrbitN onSqSize) onFrom onTo) (i : I) (j : I) : OrbitN onSqSize
    [ ~i -> onLeft @ j, i -> onRight @ j, ~j -> onFrom, j -> onTo ]
-- The charter and its ratifications (S6, O20): an inductive-inductive
-- block. Ratified c is a rule ratified at the charter c, adopt adds a
-- ratified rule to a charter, and adoptTwice is law 4 in the type: a
-- second adoption of the same rule is a path from the first. A squash at
-- each sort in the form of Trunc0 squash0 makes each sort a set. Field
-- names are global (rule R4), so each has the prefix of its constructor.
-- The rule type is Size (S3, USER ruling Q-S3-7 (a)): the block has no
-- parameter, so it is not a type constructor (rule R1).
family Charter := genesis
  | adopt (adoptBase : Charter) (adoptRule : Ratified adoptBase)
  | adoptTwice (twiceBase : Charter) (twiceRule : Size) (i : I)
    [ ~i -> adopt twiceBase (ratify twiceBase twiceRule), i -> adopt (adopt twiceBase (ratify twiceBase twiceRule)) (ratify (adopt twiceBase (ratify twiceBase twiceRule)) twiceRule) ]
  | charterSquash (charterFrom : Charter) (charterTo : Charter) (charterLeft : Path Charter charterFrom charterTo) (charterRight : Path Charter charterFrom charterTo) (i : I) (j : I)
    [ ~i -> charterLeft @ j, i -> charterRight @ j, ~j -> charterFrom, j -> charterTo ]
and Ratified : Charter -> Type 0 := ratify (ratifyBase : Charter) (ratifyRule : Size) : Ratified ratifyBase
  | ratifiedSquash (ratifiedAt : Charter) (ratifiedFrom : Ratified ratifiedAt) (ratifiedTo : Ratified ratifiedAt) (ratifiedLeft : Path (Ratified ratifiedAt) ratifiedFrom ratifiedTo) (ratifiedRight : Path (Ratified ratifiedAt) ratifiedFrom ratifiedTo) (i : I) (j : I) : Ratified ratifiedAt
    [ ~i -> ratifiedLeft @ j, i -> ratifiedRight @ j, ~j -> ratifiedFrom, j -> ratifiedTo ]

-- Equivalences (S3a, R3 (a)): contractible types, fibers, isEquiv and
-- Equiv as Sigma types (the map, then for each y the center pack x p and
-- the contraction), idEquiv, and isoToEquiv as in agda/cubical
-- isoToIsEquiv. isoCap is the fill at k = i1; isoPath is the first part
-- of the fiber path. The squares are inline, with j flipped.
def isContr : (A : Type 0) -> Type 0 :=
  fun (A : Type 0) => Sigma (c : A) ((x : A) -> Path A c x)
def fiber : (A : Type 0) -> (B : Type 0) -> (f : A -> B) -> (y : B) -> Type 0 :=
  fun (A : Type 0) => fun (B : Type 0) => fun (f : A -> B) => fun (y : B) => Sigma (x : A) (Path B (f x) y)
def isEquiv : (A : Type 0) -> (B : Type 0) -> (f : A -> B) -> Type 0 :=
  fun (A : Type 0) => fun (B : Type 0) => fun (f : A -> B) => (y : B) -> isContr (fiber A B f y)
def Equiv : (A : Type 0) -> (B : Type 0) -> Type 0 :=
  fun (A : Type 0) => fun (B : Type 0) => Sigma (f : A -> B) (isEquiv A B f)
def idEquiv : (A : Type 0) -> Equiv A A :=
  fun (A : Type 0) => pack (fun (x : A) => x) (fun (y : A) =>
    pack (pack y refl) (fun (z : fiber A A (fun (x : A) => x) y) =>
      fun (i : I) => pack (payload z @ ~i) (fun (j : I) => payload z @ (~i \/ j))))
def isoCap : (A : Type 0) -> (B : Type 0) -> (f : A -> B) -> (g : B -> A) -> (t : (x : A) -> Path A (g (f x)) x) ->
  (y : B) -> (x0 : A) -> (p0 : Path B (f x0) y) -> Path A (g y) x0 :=
  fun (A : Type 0) => fun (B : Type 0) => fun (f : A -> B) => fun (g : B -> A) => fun (t : (x : A) -> Path A (g (f x)) x) =>
  fun (y : B) => fun (x0 : A) => fun (p0 : Path B (f x0) y) =>
    fun (i : I) => hcomp A (i \/ ~i \/ ~i1) (fun (m : I) => [ i -> t x0 @ (i1 /\ m), ~i -> g y, ~i1 -> g (p0 @ ~i) ]) (g (p0 @ ~i))
def isoPath : (A : Type 0) -> (B : Type 0) -> (f : A -> B) -> (g : B -> A) -> (t : (x : A) -> Path A (g (f x)) x) ->
  (y : B) -> (x0 : A) -> (p0 : Path B (f x0) y) -> (x1 : A) -> (p1 : Path B (f x1) y) -> Path A x0 x1 :=
  fun (A : Type 0) => fun (B : Type 0) => fun (f : A -> B) => fun (g : B -> A) => fun (t : (x : A) -> Path A (g (f x)) x) =>
  fun (y : B) => fun (x0 : A) => fun (p0 : Path B (f x0) y) => fun (x1 : A) => fun (p1 : Path B (f x1) y) =>
    fun (i : I) => hcomp A (i \/ ~i \/ ~i1) (fun (m2 : I) => [ i -> isoCap A B f g t y x1 p1 @ (i1 /\ m2), ~i -> isoCap A B f g t y x0 p0 @ (i1 /\ m2), ~i1 -> g y ]) (g y)
def isoToEquiv : (A : Type 0) -> (B : Type 0) -> (f : A -> B) -> (g : B -> A) ->
  (s : (y : B) -> Path B (f (g y)) y) -> (t : (x : A) -> Path A (g (f x)) x) -> Equiv A B :=
  fun (A : Type 0) => fun (B : Type 0) => fun (f : A -> B) => fun (g : B -> A) =>
  fun (s : (y : B) -> Path B (f (g y)) y) => fun (t : (x : A) -> Path A (g (f x)) x) =>
  pack f (fun (y : B) => pack (pack (g y) (s y)) (fun (z : fiber A B f y) =>
    fun (i : I) => pack (isoPath A B f g t y (g y) (s y) (witness z) (payload z) @ i) (fun (j : I) =>
      hcomp B (i \/ ~i \/ ~j \/ j) (fun (m4 : I) => [
        i -> s (payload z @ j) @ m4,
        ~i -> s (s y @ j) @ m4,
        ~j -> s (f (isoPath A B f g t y (g y) (s y) (witness z) (payload z) @ i)) @ m4,
        j -> s y @ m4 ])
      (f (hcomp A (i \/ ~i \/ ~j \/ j) (fun (m3 : I) => [
        i -> hcomp A (~j \/ j \/ m3) (fun (m : I) => [ ~j -> t (witness z) @ (~m3 /\ m), j -> g y, m3 -> g (payload z @ j) ]) (g (payload z @ j)),
        ~i -> hcomp A (~j \/ j \/ m3) (fun (m : I) => [ ~j -> t (g y) @ (~m3 /\ m), j -> g y, m3 -> g (s y @ j) ]) (g (s y @ j)),
        ~j -> t (isoPath A B f g t y (g y) (s y) (witness z) (payload z) @ i) @ ~m3,
        j -> g y ])
        (hcomp A (i \/ ~i \/ j) (fun (m2 : I) => [
          i -> isoCap A B f g t y (witness z) (payload z) @ (~j /\ m2),
          ~i -> isoCap A B f g t y (g y) (s y) @ (~j /\ m2),
          j -> g y ]) (g y)))))))

-- ua (S3b): the Glue line from A to B. At i0 the type is A through e; at
-- i1 the type is B through idEquiv B. Transport along ua e at a closed
-- value of A gives witness e of the value (uaBeta).
def ua : (A : Type 0) -> (B : Type 0) -> (e : Equiv A B) -> Path (Type 0) A B :=
  fun (A : Type 0) => fun (B : Type 0) => fun (e : Equiv A B) =>
    fun (i : I) => Glue B (~i \/ i) (fun (_ : I) => [ ~i -> pack A e, i -> pack B (idEquiv B) ])
-- uaArrow (S3c): agda/cubical ua-> with a constant C. A path h a from
-- f0 a to f1 (witness e a) for each a gives a path of functions over ua e
-- from f0 to f1. At i0 the hcomp is its ~i tube at j = i1, h a @ i0 =
-- f0 a; at i1 it is its i tube, f1 a. The base is f1 (unglue a).
def uaArrow : (A : Type 0) -> (B : Type 0) -> (C : Type 0) -> (e : Equiv A B) -> (f0 : A -> C) -> (f1 : B -> C) ->
  (h : (a : A) -> Path C (f0 a) (f1 (witness e a))) -> PathP (fun (i : I) => (ua A B e @ i) -> C) f0 f1 :=
  fun (A : Type 0) => fun (B : Type 0) => fun (C : Type 0) => fun (e : Equiv A B) => fun (f0 : A -> C) => fun (f1 : B -> C) =>
  fun (h : (a : A) -> Path C (f0 a) (f1 (witness e a))) =>
    fun (i : I) => fun (a : ua A B e @ i) => hcomp C (~i \/ i) (fun (j : I) => [ ~i -> h a @ ~j, i -> f1 a ]) (f1 (unglue a))
