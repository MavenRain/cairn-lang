def orbitNExt : (T : Size -> Type 0) -> ((n : Size) -> isSet (T n)) -> (L : (n : Size) -> OrbitN n -> T n) -> (M : (n : Size) -> OrbitN n -> T n) -> ((n : Size) -> (c : Pos n -> Choice) -> Path (T n) (L n (orbitNOf n c)) (M n (orbitNOf n c))) -> (k : Size) -> (x : OrbitN k) -> Path (T k) (L k x) (M k x) :=
  fun (T : Size -> Type 0) (sT : (n : Size) -> isSet (T n)) (L : (n : Size) -> OrbitN n -> T n) (M : (n : Size) -> OrbitN n -> T n) (h : (n : Size) -> (c : Pos n -> Choice) -> Path (T n) (L n (orbitNOf n c)) (M n (orbitNOf n c))) (k : Size) (x : OrbitN k) => elim (fun (n : Size) (z : OrbitN n) => Path (T n) (L n z) (M n z)) (fun (n : Size) (c : Pos n -> Choice) => h n c) (fun (n : Size) (a : Pos n -> Choice) (b : Pos n -> Choice) (r : swapR n a b) (i : I) => propOver (OrbitN n) (fun (z : OrbitN n) => Path (T n) (L n z) (M n z)) (fun (z : OrbitN n) => sT n (L n z) (M n z)) (orbitNOf n a) (orbitNOf n b) (fun (e : I) => orbitNEq n a b r e) (h n a) (h n b) @ i) (fun (n : Size) (w : OrbitN n) (ihw : Path (T n) (L n w) (M n w)) (y : OrbitN n) (ihy : Path (T n) (L n y) (M n y)) (p : Path (OrbitN n) w y) (ihp : PathP (fun (j : I) => Path (T n) (L n (p @ j)) (M n (p @ j))) ihw ihy) (q : Path (OrbitN n) w y) (ihq : PathP (fun (j : I) => Path (T n) (L n (q @ j)) (M n (q @ j))) ihw ihy) (i : I) (j : I) => propSquare (OrbitN n) (fun (z : OrbitN n) => Path (T n) (L n z) (M n z)) (fun (z : OrbitN n) => sT n (L n z) (M n z)) w y p q (fun (m : I) (o : I) => orbitNSquash n w y p q m o) ihw ihy ihp ihq @ i @ j) x

