-- The bag orbit theorem (slice S7 B3, PLAN Q4 and Q5), guest mode: at each size n the orbits of the
-- configurations Pos n -> Choice under the word action are the bags of n choices.
def Choice : Type 0 := Sum Unit Unit

-- rebuild k e is e after one step of elim on the size, and rebuildPath is the path to e (funext of
-- rebuildEta). It gives the empty configuration at sz0 and the eta of consP at szS m.
def rebuild : (k : Size) -> (Pos k -> Choice) -> Pos k -> Choice :=
  fun (k : Size) => elim (fun (t : Size) => (Pos t -> Choice) -> Pos t -> Choice) (fun (e : Pos sz0 -> Choice) (q : Pos sz0) => inl unit) (fun (m : Size) (ih : (Pos m -> Choice) -> Pos m -> Choice) (e : Pos (szS m) -> Choice) => consP m (e (posFirst m)) (fun (p : Pos m) => e (posNext m p))) k

def rebuildEta : (k : Size) -> (q : Pos k) -> (e : Pos k -> Choice) -> Path Choice (rebuild k e q) (e q) :=
  fun (k : Size) (q : Pos k) => elim (fun (t : Size) (p : Pos t) => (e : Pos t -> Choice) -> Path Choice (rebuild t e p) (e p)) (fun (m : Size) (e : Pos (szS m) -> Choice) => refl) (fun (m : Size) (p : Pos m) (ih : (e : Pos m -> Choice) -> Path Choice (rebuild m e p) (e p)) (e : Pos (szS m) -> Choice) => refl) q

def rebuildPath : (k : Size) -> (e : Pos k -> Choice) -> Path (Pos k -> Choice) (rebuild k e) e :=
  fun (k : Size) (e : Pos k -> Choice) (i : I) (q : Pos k) => rebuildEta k q e @ i

-- liftFront applies a word to the tail (consP, swapFront and actW are in domain.lang).
def liftFront : (m : Size) -> Word m -> (Pos (szS m) -> Choice) -> Pos (szS m) -> Choice :=
  fun (m : Size) (u : Word m) (d : Pos (szS m) -> Choice) => consP m (d (posFirst m)) (actW m u (fun (p : Pos m) => d (posNext m p)))

-- swapR is the relation of the kernel Orbit and of OrbitN (domain.lang). Both families are sets by their squash.
def swapR : (n : Size) -> (Pos n -> Choice) -> (Pos n -> Choice) -> Type 0 :=
  fun (n : Size) (c : Pos n -> Choice) (d : Pos n -> Choice) => Sigma (w : Word n) (Path (Pos n -> Choice) (actW n w d) c)

def isSetOrbitN : (k : Size) -> isSet (OrbitN k) :=
  fun (k : Size) (x : OrbitN k) (y : OrbitN k) (p : Path (OrbitN k) x y) (q : Path (OrbitN k) x y) (i : I) (j : I) => orbitNSquash k x y p q i j

def isSetBag : (k : Size) -> isSet (ChoiceBag k) :=
  fun (k : Size) (x : ChoiceBag k) (y : ChoiceBag k) (p : Path (ChoiceBag k) x y) (q : Path (ChoiceBag k) x y) (i : I) (j : I) => choiceSquash k x y p q i j

-- listB lists a configuration in position order. A word moves the list by one bag swap for each letter.
def listB : (k : Size) -> (Pos k -> Choice) -> ChoiceBag k :=
  fun (k : Size) => elim (fun (t : Size) => (Pos t -> Choice) -> ChoiceBag t) (fun (e : Pos sz0 -> Choice) => choiceNil) (fun (m : Size) (ih : (Pos m -> Choice) -> ChoiceBag m) (e : Pos (szS m) -> Choice) => choiceCons m (e (posFirst m)) (ih (fun (p : Pos m) => e (posNext m p)))) k

def swapList : (m : Size) -> (c : Pos (szS (szS m)) -> Choice) -> Path (ChoiceBag (szS (szS m))) (listB (szS (szS m)) (swapFront m c)) (listB (szS (szS m)) c) :=
  fun (m : Size) (c : Pos (szS (szS m)) -> Choice) (i : I) => choiceSwap m (c (posNext (szS m) (posFirst m))) (c (posFirst (szS m))) (listB m (fun (p : Pos m) => c (posNext (szS m) (posNext m p)))) i

def listAct : (n : Size) -> (w : Word n) -> (d : Pos n -> Choice) -> Path (ChoiceBag n) (listB n (actW n w d)) (listB n d) :=
  fun (n : Size) (w : Word n) => elim (fun (k : Size) (v : Word k) => (d : Pos k -> Choice) -> Path (ChoiceBag k) (listB k (actW k v d)) (listB k d)) (fun (k : Size) (d : Pos k -> Choice) => refl) (fun (m : Size) (v : Word (szS (szS m))) (ih : (d : Pos (szS (szS m)) -> Choice) -> Path (ChoiceBag (szS (szS m))) (listB (szS (szS m)) (actW (szS (szS m)) v d)) (listB (szS (szS m)) d)) (d : Pos (szS (szS m)) -> Choice) => trans (ChoiceBag (szS (szS m))) (listB (szS (szS m)) (swapFront m (actW (szS (szS m)) v d))) (listB (szS (szS m)) (actW (szS (szS m)) v d)) (listB (szS (szS m)) d) (swapList m (actW (szS (szS m)) v d)) (ih d)) (fun (m : Size) (u : Word m) (ihu : (d : Pos m -> Choice) -> Path (ChoiceBag m) (listB m (actW m u d)) (listB m d)) (v : Word (szS m)) (ihv : (d : Pos (szS m) -> Choice) -> Path (ChoiceBag (szS m)) (listB (szS m) (actW (szS m) v d)) (listB (szS m) d)) (d : Pos (szS m) -> Choice) => trans (ChoiceBag (szS m)) (listB (szS m) (actW (szS m) v (liftFront m u d))) (listB (szS m) (liftFront m u d)) (listB (szS m) d) (ihv (liftFront m u d)) (fun (i : I) => choiceCons m (d (posFirst m)) (ihu (fun (p : Pos m) => d (posNext m p)) @ i))) w

-- toBag is an elim on OrbitN: the orbitNEq case is the path of r, then listAct on the word.
def toBag : (k : Size) -> OrbitN k -> ChoiceBag k :=
  fun (k : Size) (z : OrbitN k) => elim (fun (n : Size) (x : OrbitN n) => ChoiceBag n) (fun (n : Size) (c : Pos n -> Choice) => listB n c) (fun (n : Size) (c : Pos n -> Choice) (d : Pos n -> Choice) (r : swapR n c d) (i : I) => trans (ChoiceBag n) (listB n c) (listB n (actW n (witness r) d)) (listB n d) (sym (cong (listB n) (payload r))) (listAct n (witness r) d) @ i) (fun (n : Size) (w : OrbitN n) (ihw : ChoiceBag n) (v : OrbitN n) (ihv : ChoiceBag n) (p : Path (OrbitN n) w v) (ihp : Path (ChoiceBag n) ihw ihv) (q : Path (OrbitN n) w v) (ihq : Path (ChoiceBag n) ihw ihv) (i : I) (j : I) => isSetBag n ihw ihv ihp ihq @ i @ j) z

-- consO puts a choice in front of an orbit. The orbitNEq case lifts the word of r to the tail.
def consO : (m : Size) -> Choice -> OrbitN m -> OrbitN (szS m) :=
  fun (m : Size) (a : Choice) (z : OrbitN m) => elim (fun (n : Size) (x : OrbitN n) => OrbitN (szS n)) (fun (n : Size) (c : Pos n -> Choice) => orbitNOf (szS n) (consP n a c)) (fun (n : Size) (c : Pos n -> Choice) (d : Pos n -> Choice) (r : swapR n c d) (i : I) => orbitNEq (szS n) (consP n a c) (consP n a d) (pack (wordLift n (witness r) (wordNil (szS n))) (fun (j : I) => consP n a (payload r @ j))) i) (fun (n : Size) (w : OrbitN n) (ihw : OrbitN (szS n)) (v : OrbitN n) (ihv : OrbitN (szS n)) (p : Path (OrbitN n) w v) (ihp : Path (OrbitN (szS n)) ihw ihv) (q : Path (OrbitN n) w v) (ihq : Path (OrbitN (szS n)) ihw ihv) (i : I) (j : I) => isSetOrbitN (szS n) ihw ihv ihp ihq @ i @ j) z

-- A family of propositions over a path or a square has each PathP (copied from dao.lang).
def propOver : (X : Type 0) -> (P : X -> Type 0) -> ((x : X) -> isProp (P x)) -> (a : X) -> (b : X) -> (q : Path X a b) -> (u : P a) -> (v : P b) -> PathP (fun (i : I) => P (q @ i)) u v :=
  fun (X : Type 0) (P : X -> Type 0) (hP : (x : X) -> isProp (P x)) (a : X) (b : X) (q : Path X a b) (u : P a) (v : P b) (i : I) => hcomp (P (q @ i)) (~i \/ i) (fun (k : I) => [ ~i -> hP (q @ i) (transp (fun (m : I) => P (q @ (i /\ m))) i0 u) u @ k, i -> hP (q @ i) (transp (fun (m : I) => P (q @ (i /\ m))) i0 u) v @ k ]) (transp (fun (m : I) => P (q @ (i /\ m))) i0 u)

def propSquare : (X : Type 0) -> (P : X -> Type 0) -> ((x : X) -> isProp (P x)) -> (x : X) -> (y : X) -> (p : Path X x y) -> (q : Path X x y) -> (s : Path (Path X x y) p q) -> (ihx : P x) -> (ihy : P y) -> (ihp : PathP (fun (j : I) => P (p @ j)) ihx ihy) -> (ihq : PathP (fun (j : I) => P (q @ j)) ihx ihy) -> PathP (fun (i : I) => PathP (fun (j : I) => P (s @ i @ j)) ihx ihy) ihp ihq :=
  fun (X : Type 0) (P : X -> Type 0) (hP : (x : X) -> isProp (P x)) (x : X) (y : X) (p : Path X x y) (q : Path X x y) (s : Path (Path X x y) p q) (ihx : P x) (ihy : P y) (ihp : PathP (fun (j : I) => P (p @ j)) ihx ihy) (ihq : PathP (fun (j : I) => P (q @ j)) ihx ihy) (i : I) (j : I) => hcomp (P (s @ i @ j)) (~i \/ i \/ ~j \/ j) (fun (k : I) => [ ~i -> hP (s @ i @ j) (transp (fun (m : I) => P (s @ (i /\ m) @ (j /\ m))) i0 ihx) (ihp @ j) @ k, i -> hP (s @ i @ j) (transp (fun (m : I) => P (s @ (i /\ m) @ (j /\ m))) i0 ihx) (ihq @ j) @ k, ~j -> hP (s @ i @ j) (transp (fun (m : I) => P (s @ (i /\ m) @ (j /\ m))) i0 ihx) ihx @ k, j -> hP (s @ i @ j) (transp (fun (m : I) => P (s @ (i /\ m) @ (j /\ m))) i0 ihx) ihy @ k ]) (transp (fun (m : I) => P (s @ (i /\ m) @ (j /\ m))) i0 ihx)

-- Two maps into a set agree on OrbitN when they agree at orbitNOf (the orbitExt shape of dao.lang), and two
