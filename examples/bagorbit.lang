  fun (sB : (k : Size) -> isSet (ChoiceBag k)) (L : (k : Size) -> ChoiceBag k -> ChoiceBag k) (M : (k : Size) -> ChoiceBag k -> ChoiceBag k) (hNil : Path (ChoiceBag sz0) (L sz0 choiceNil) (M sz0 choiceNil)) (hCons : (m : Size) -> (a : Choice) -> (t : ChoiceBag m) -> Path (ChoiceBag m) (L m t) (M m t) -> Path (ChoiceBag (szS m)) (L (szS m) (choiceCons m a t)) (M (szS m) (choiceCons m a t))) (k : Size) (y : ChoiceBag k) => elim (fun (n : Size) (z : ChoiceBag n) => Path (ChoiceBag n) (L n z) (M n z)) hNil (fun (m : Size) (a : Choice) (t : ChoiceBag m) (ih : Path (ChoiceBag m) (L m t) (M m t)) => hCons m a t ih) (fun (m : Size) (a : Choice) (b : Choice) (t : ChoiceBag m) (ih : Path (ChoiceBag m) (L m t) (M m t)) (i : I) => propOver (ChoiceBag (szS (szS m))) (fun (z : ChoiceBag (szS (szS m))) => Path (ChoiceBag (szS (szS m))) (L (szS (szS m)) z) (M (szS (szS m)) z)) (fun (z : ChoiceBag (szS (szS m))) => sB (szS (szS m)) (L (szS (szS m)) z) (M (szS (szS m)) z)) (choiceCons (szS m) a (choiceCons m b t)) (choiceCons (szS m) b (choiceCons m a t)) (fun (k : I) => choiceSwap m a b t k) (hCons (szS m) a (choiceCons m b t) (hCons m b t ih)) (hCons (szS m) b (choiceCons m a t) (hCons m a t ih)) @ i) (fun (n : Size) (w : ChoiceBag n) (ihw : Path (ChoiceBag n) (L n w) (M n w)) (v : ChoiceBag n) (ihv : Path (ChoiceBag n) (L n v) (M n v)) (p : Path (ChoiceBag n) w v) (ihp : PathP (fun (j : I) => Path (ChoiceBag n) (L n (p @ j)) (M n (p @ j))) ihw ihv) (q : Path (ChoiceBag n) w v) (ihq : PathP (fun (j : I) => Path (ChoiceBag n) (L n (q @ j)) (M n (q @ j))) ihw ihv) (i : I) (j : I) => propSquare (ChoiceBag n) (fun (z : ChoiceBag n) => Path (ChoiceBag n) (L n z) (M n z)) (fun (z : ChoiceBag n) => sB n (L n z) (M n z)) w v p q (fun (m : I) (o : I) => choiceSquash n w v p q m o) ihw ihv ihp ihq @ i @ j) y

-- fromBagW sw is elim on ChoiceBag. The choiceSwap case is sw, and the choiceSquash case is isSetOrbitN. swapO is a swap
-- case: a path in OrbitN by orbitNExt and the word that swaps the first two positions. fromBag is fromBagW swapO.
-- The kernel compares two closures by eta, so each comparison of two fromBag values unfolds swapO and does
-- not fit in the arena. A variable sw keeps these comparisons small.
def SwapCase : Type 0 :=
  (m : Size) -> (a : Choice) -> (b : Choice) -> (x : OrbitN m) -> Path (OrbitN (szS (szS m))) (consO (szS m) a (consO m b x)) (consO (szS m) b (consO m a x))

def swapO : SwapCase :=
  fun (m : Size) (a : Choice) (b : Choice) (x : OrbitN m) => orbitNExt (fun (n : Size) => OrbitN (szS (szS n))) (fun (n : Size) => isSetOrbitN (szS (szS n))) (fun (n : Size) (z : OrbitN n) => consO (szS n) a (consO n b z)) (fun (n : Size) (z : OrbitN n) => consO (szS n) b (consO n a z)) (fun (n : Size) (c : Pos n -> Choice) (i : I) => orbitNEq (szS (szS n)) (consP (szS n) a (consP n b c)) (consP (szS n) b (consP n a c)) (pack (wordSwap n (wordNil (szS (szS n)))) refl) i) m x

def fromBagW : SwapCase -> (k : Size) -> ChoiceBag k -> OrbitN k :=
  fun (sw : SwapCase) (k : Size) (y : ChoiceBag k) => elim (fun (n : Size) (z : ChoiceBag n) => OrbitN n) (orbitNOf sz0 (fun (q : Pos sz0) => inl unit)) (fun (m : Size) (a : Choice) (t : ChoiceBag m) (ih : OrbitN m) => consO m a ih) (fun (m : Size) (a : Choice) (b : Choice) (t : ChoiceBag m) (ih : OrbitN m) (i : I) => sw m a b ih @ i) (fun (n : Size) (w : ChoiceBag n) (ihw : OrbitN n) (v : ChoiceBag n) (ihv : OrbitN n) (p : Path (ChoiceBag n) w v) (ihp : Path (OrbitN n) ihw ihv) (q : Path (ChoiceBag n) w v) (ihq : Path (OrbitN n) ihw ihv) (i : I) (j : I) => isSetOrbitN n ihw ihv ihp ihq @ i @ j) y

def fromBag : (k : Size) -> ChoiceBag k -> OrbitN k := fromBagW swapO

-- The two homotopies hold for each map G with the choiceNil and choiceCons rules of fromBag. G is a variable,
-- so a motive does not unfold fromBag (the elim of fromBag at a stuck bag is too large for the arena).
def NilRule : ((k : Size) -> ChoiceBag k -> OrbitN k) -> Type 0 :=
  fun (G : (k : Size) -> ChoiceBag k -> OrbitN k) => Path (OrbitN sz0) (G sz0 choiceNil) (orbitNOf sz0 (fun (q : Pos sz0) => inl unit))

def ConsRule : ((k : Size) -> ChoiceBag k -> OrbitN k) -> Type 0 :=
  fun (G : (k : Size) -> ChoiceBag k -> OrbitN k) => (m : Size) -> (a : Choice) -> (t : ChoiceBag m) -> Path (OrbitN (szS m)) (G (szS m) (choiceCons m a t)) (consO m a (G m t))

-- G after toBag is the identity: at orbitNOf by elim on the size (the nil rule and rebuildPath at sz0, the
-- cons rule, consO of the hypothesis and rebuildPath at szS m), then by orbitNExt.
def fromToQuot : (G : (k : Size) -> ChoiceBag k -> OrbitN k) -> NilRule G -> ConsRule G -> (k : Size) -> (c : Pos k -> Choice) -> Path (OrbitN k) (G k (listB k c)) (orbitNOf k c) :=
  fun (G : (k : Size) -> ChoiceBag k -> OrbitN k) (hN : NilRule G) (hC : ConsRule G) (k : Size) => elim (fun (t : Size) => (c : Pos t -> Choice) -> Path (OrbitN t) (G t (listB t c)) (orbitNOf t c)) (fun (c : Pos sz0 -> Choice) => trans (OrbitN sz0) (G sz0 (listB sz0 c)) (orbitNOf sz0 (rebuild sz0 c)) (orbitNOf sz0 c) hN (fun (i : I) => orbitNOf sz0 (rebuildPath sz0 c @ i))) (fun (m : Size) (ih : (c : Pos m -> Choice) -> Path (OrbitN m) (G m (listB m c)) (orbitNOf m c)) (c : Pos (szS m) -> Choice) => trans (OrbitN (szS m)) (G (szS m) (listB (szS m) c)) (consO m (c (posFirst m)) (G m (listB m (fun (p : Pos m) => c (posNext m p))))) (orbitNOf (szS m) c) (hC m (c (posFirst m)) (listB m (fun (p : Pos m) => c (posNext m p)))) (trans (OrbitN (szS m)) (consO m (c (posFirst m)) (G m (listB m (fun (p : Pos m) => c (posNext m p))))) (orbitNOf (szS m) (rebuild (szS m) c)) (orbitNOf (szS m) c) (fun (i : I) => consO m (c (posFirst m)) (ih (fun (p : Pos m) => c (posNext m p)) @ i)) (fun (i : I) => orbitNOf (szS m) (rebuildPath (szS m) c @ i)))) k

def fromTo : (G : (k : Size) -> ChoiceBag k -> OrbitN k) -> NilRule G -> ConsRule G -> (k : Size) -> (x : OrbitN k) -> Path (OrbitN k) (G k (toBag k x)) x :=
  fun (G : (k : Size) -> ChoiceBag k -> OrbitN k) (hN : NilRule G) (hC : ConsRule G) (k : Size) (x : OrbitN k) => orbitNExt (fun (n : Size) => OrbitN n) isSetOrbitN (fun (n : Size) (z : OrbitN n) => G n (toBag n z)) (fun (n : Size) (z : OrbitN n) => z) (fromToQuot G hN hC) k x

-- toBag after fromBag is the identity: toBag of consO is choiceCons (refl at orbitNOf), then bagExt.
def toCons : (m : Size) -> (a : Choice) -> (x : OrbitN m) -> Path (ChoiceBag (szS m)) (toBag (szS m) (consO m a x)) (choiceCons m a (toBag m x)) :=
  fun (m : Size) (a : Choice) (x : OrbitN m) => orbitNExt (fun (n : Size) => ChoiceBag (szS n)) (fun (n : Size) => isSetBag (szS n)) (fun (n : Size) (z : OrbitN n) => toBag (szS n) (consO n a z)) (fun (n : Size) (z : OrbitN n) => choiceCons n a (toBag n z)) (fun (n : Size) (c : Pos n -> Choice) => refl) m x

def toFrom : (G : (k : Size) -> ChoiceBag k -> OrbitN k) -> NilRule G -> ConsRule G -> (k : Size) -> (y : ChoiceBag k) -> Path (ChoiceBag k) (toBag k (G k y)) y :=
  fun (G : (k : Size) -> ChoiceBag k -> OrbitN k) (hN : NilRule G) (hC : ConsRule G) (k : Size) (y : ChoiceBag k) => bagExt isSetBag (fun (n : Size) (z : ChoiceBag n) => toBag n (G n z)) (fun (n : Size) (z : ChoiceBag n) => z) (fun (i : I) => toBag sz0 (hN @ i)) (fun (m : Size) (a : Choice) (t : ChoiceBag m) (ih : Path (ChoiceBag m) (toBag m (G m t)) t) => trans (ChoiceBag (szS m)) (toBag (szS m) (G (szS m) (choiceCons m a t))) (toBag (szS m) (consO m a (G m t))) (choiceCons m a t) (fun (i : I) => toBag (szS m) (hC m a t @ i)) (trans (ChoiceBag (szS m)) (toBag (szS m) (consO m a (G m t))) (choiceCons m a (toBag m (G m t))) (choiceCons m a t) (toCons m a (G m t)) (fun (i : I) => choiceCons m a (ih @ i)))) k y

-- fromBagW sw has the two rules by the elim rule. bagOrbitW holds at each swap case sw. The theorem: the
-- orbits at size k are the bags of k choices, with fromBag as the inverse. Its type does not name sw.
def fromBagNil : (sw : SwapCase) -> NilRule (fromBagW sw) := fun (sw : SwapCase) => refl

def fromBagCons : (sw : SwapCase) -> ConsRule (fromBagW sw) :=
  fun (sw : SwapCase) (m : Size) (a : Choice) (t : ChoiceBag m) => refl

def bagOrbitW : SwapCase -> (k : Size) -> Equiv (OrbitN k) (ChoiceBag k) :=
  fun (sw : SwapCase) (k : Size) => isoToEquiv (OrbitN k) (ChoiceBag k) (toBag k) (fromBagW sw k) (toFrom (fromBagW sw) (fromBagNil sw) (fromBagCons sw) k) (fromTo (fromBagW sw) (fromBagNil sw) (fromBagCons sw) k)

def bagOrbit : (k : Size) -> Equiv (OrbitN k) (ChoiceBag k) := bagOrbitW swapO

-- The example row: a DAO program with Member Pos n0 and Group Word n0 at three positions. The kernel gives
-- the family Orbit after act (S3, design C 2a). Orbit and OrbitN n0 have the same point and path constructors,
-- so toOrbitN (a fold) and fromOrbitN (fromAt n0) are inverse, orbitRow is ua of that iso, and bagOrbit n0 gives its bags.
def n0 : Size := szS (szS (szS sz0))

def Member : Type 0 := Pos n0

def Group : Type 0 := Word n0

def act : Group -> (Member -> Choice) -> Member -> Choice := actW n0

def isSetOrbit : isSet Orbit :=
  fun (x : Orbit) (y : Orbit) (p : Path Orbit x y) (q : Path Orbit x y) (i : I) (j : I) => orbitSquash x y p q i j

def toOrbitN : Orbit -> OrbitN n0 :=
  fun (z : Orbit) => fold (fun (c : Member -> Choice) => orbitNOf n0 c) (fun (a : Member -> Choice) (b : Member -> Choice) (r : swapR n0 a b) (i : I) => orbitNEq n0 a b r i) (isSetOrbitN n0) z

-- An elim on OrbitN has a motive over all sizes, so fromOrbitN is fromAt n0 into OrbAt: Orbit at n0 and OrbitN n
-- at each other size, by elim on the size to depth 4. sel5 takes a value at sizes 0, 1, 2, n0 and a value above n0.
def size4 : Size -> Size := fun (k : Size) => szS (szS (szS (szS k)))

def sel5 : (P : Size -> Type 0) -> P sz0 -> P (szS sz0) -> P (szS (szS sz0)) -> P n0 -> ((k : Size) -> P (size4 k)) -> (n : Size) -> P n :=
  fun (P : Size -> Type 0) (p0 : P sz0) (p1 : P (szS sz0)) (p2 : P (szS (szS sz0))) (p3 : P n0) (p4 : (k : Size) -> P (size4 k)) (n : Size) => elim (fun (t : Size) => P t) p0 (fun (t1 : Size) (h1 : P t1) => elim (fun (u : Size) => P (szS u)) p1 (fun (t2 : Size) (h2 : P (szS t2)) => elim (fun (u : Size) => P (szS (szS u))) p2 (fun (t3 : Size) (h3 : P (szS (szS t3))) => elim (fun (u : Size) => P (szS (szS (szS u)))) p3 (fun (t4 : Size) (h4 : P (szS (szS (szS t4)))) => p4 t4) t3) t2) t1) n

def OrbAt : Size -> Type 0 :=
  fun (n : Size) => elim (fun (t : Size) => Type 0) (OrbitN sz0) (fun (t1 : Size) (h1 : Type 0) => elim (fun (u : Size) => Type 0) (OrbitN (szS sz0)) (fun (t2 : Size) (h2 : Type 0) => elim (fun (u : Size) => Type 0) (OrbitN (szS (szS sz0))) (fun (t3 : Size) (h3 : Type 0) => elim (fun (u : Size) => Type 0) Orbit (fun (t4 : Size) (h4 : Type 0) => OrbitN (size4 t4)) t3) t2) t1) n

def mkO : (n : Size) -> (Pos n -> Choice) -> OrbAt n :=
  sel5 (fun (n : Size) => (Pos n -> Choice) -> OrbAt n) (fun (c : Pos sz0 -> Choice) => orbitNOf sz0 c) (fun (c : Pos (szS sz0) -> Choice) => orbitNOf (szS sz0) c) (fun (c : Pos (szS (szS sz0)) -> Choice) => orbitNOf (szS (szS sz0)) c) (fun (c : Member -> Choice) => orbitProj c) (fun (k : Size) (c : Pos (size4 k) -> Choice) => orbitNOf (size4 k) c)

def mkEqO : (n : Size) -> (a : Pos n -> Choice) -> (b : Pos n -> Choice) -> swapR n a b -> Path (OrbAt n) (mkO n a) (mkO n b) :=
  sel5 (fun (n : Size) => (a : Pos n -> Choice) -> (b : Pos n -> Choice) -> swapR n a b -> Path (OrbAt n) (mkO n a) (mkO n b)) (fun (a : Pos sz0 -> Choice) (b : Pos sz0 -> Choice) (r : swapR sz0 a b) (i : I) => orbitNEq sz0 a b r i) (fun (a : Pos (szS sz0) -> Choice) (b : Pos (szS sz0) -> Choice) (r : swapR (szS sz0) a b) (i : I) => orbitNEq (szS sz0) a b r i) (fun (a : Pos (szS (szS sz0)) -> Choice) (b : Pos (szS (szS sz0)) -> Choice) (r : swapR (szS (szS sz0)) a b) (i : I) => orbitNEq (szS (szS sz0)) a b r i) (fun (a : Member -> Choice) (b : Member -> Choice) (r : swapR n0 a b) (i : I) => orbitEq a b r i) (fun (k : Size) (a : Pos (size4 k) -> Choice) (b : Pos (size4 k) -> Choice) (r : swapR (size4 k) a b) (i : I) => orbitNEq (size4 k) a b r i)

def isSetAt : (n : Size) -> isSet (OrbAt n) :=
  sel5 (fun (n : Size) => isSet (OrbAt n)) (isSetOrbitN sz0) (isSetOrbitN (szS sz0)) (isSetOrbitN (szS (szS sz0))) isSetOrbit (fun (k : Size) => isSetOrbitN (size4 k))

def fromAt : (n : Size) -> OrbitN n -> OrbAt n :=
  fun (n : Size) (z : OrbitN n) => elim (fun (t : Size) (x : OrbitN t) => OrbAt t) (fun (t : Size) (c : Pos t -> Choice) => mkO t c) (fun (t : Size) (a : Pos t -> Choice) (b : Pos t -> Choice) (r : swapR t a b) (i : I) => mkEqO t a b r @ i) (fun (t : Size) (w : OrbitN t) (ihw : OrbAt t) (v : OrbitN t) (ihv : OrbAt t) (p : Path (OrbitN t) w v) (ihp : Path (OrbAt t) ihw ihv) (q : Path (OrbitN t) w v) (ihq : Path (OrbAt t) ihw ihv) (i : I) (j : I) => isSetAt t ihw ihv ihp ihq @ i @ j) z

def fromOrbitN : OrbitN n0 -> Orbit := fromAt n0

def backAt : (n : Size) -> OrbAt n -> OrbitN n :=
  sel5 (fun (n : Size) => OrbAt n -> OrbitN n) (fun (x : OrbitN sz0) => x) (fun (x : OrbitN (szS sz0)) => x) (fun (x : OrbitN (szS (szS sz0))) => x) toOrbitN (fun (k : Size) (x : OrbitN (size4 k)) => x)

def backFrom : (n : Size) -> (c : Pos n -> Choice) -> Path (OrbitN n) (backAt n (fromAt n (orbitNOf n c))) (orbitNOf n c) :=
  sel5 (fun (n : Size) => (c : Pos n -> Choice) -> Path (OrbitN n) (backAt n (fromAt n (orbitNOf n c))) (orbitNOf n c)) (fun (c : Pos sz0 -> Choice) => refl) (fun (c : Pos (szS sz0) -> Choice) => refl) (fun (c : Pos (szS (szS sz0)) -> Choice) => refl) (fun (c : Member -> Choice) => refl) (fun (k : Size) (c : Pos (size4 k) -> Choice) => refl)

-- fromOrbitN after toOrbitN is the identity: elim on Orbit into the propositions Path Orbit (fromOrbitN (toOrbitN z)) z
-- (the orbitNExt shape), refl at orbitProj. toOrbitN after fromOrbitN is the identity by orbitNExt, refl at orbitNOf.
def orbitFromTo : (x : Orbit) -> Path Orbit (fromOrbitN (toOrbitN x)) x :=
  fun (x : Orbit) => elim (fun (z : Orbit) => Path Orbit (fromOrbitN (toOrbitN z)) z) (fun (a : Member -> Choice) => refl) (fun (a : Member -> Choice) (b : Member -> Choice) (r : swapR n0 a b) (i : I) => propOver Orbit (fun (z : Orbit) => Path Orbit (fromOrbitN (toOrbitN z)) z) (fun (z : Orbit) => isSetOrbit (fromOrbitN (toOrbitN z)) z) (orbitProj a) (orbitProj b) (fun (k : I) => orbitEq a b r k) refl refl @ i) (fun (w : Orbit) (ihw : Path Orbit (fromOrbitN (toOrbitN w)) w) (y : Orbit) (ihy : Path Orbit (fromOrbitN (toOrbitN y)) y) (p : Path Orbit w y) (ihp : PathP (fun (j : I) => Path Orbit (fromOrbitN (toOrbitN (p @ j))) (p @ j)) ihw ihy) (q : Path Orbit w y) (ihq : PathP (fun (j : I) => Path Orbit (fromOrbitN (toOrbitN (q @ j))) (q @ j)) ihw ihy) (i : I) (j : I) => propSquare Orbit (fun (z : Orbit) => Path Orbit (fromOrbitN (toOrbitN z)) z) (fun (z : Orbit) => isSetOrbit (fromOrbitN (toOrbitN z)) z) w y p q (fun (m : I) (n : I) => orbitSquash w y p q m n) ihw ihy ihp ihq @ i @ j) x

def orbitToFrom : (y : OrbitN n0) -> Path (OrbitN n0) (toOrbitN (fromOrbitN y)) y :=
  orbitNExt (fun (n : Size) => OrbitN n) isSetOrbitN (fun (n : Size) (z : OrbitN n) => backAt n (fromAt n z)) (fun (n : Size) (z : OrbitN n) => z) backFrom n0

def orbitRow : Path (Type 0) Orbit (OrbitN n0) :=
  ua Orbit (OrbitN n0) (isoToEquiv Orbit (OrbitN n0) toOrbitN fromOrbitN orbitToFrom orbitFromTo)
