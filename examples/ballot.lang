  fun (ctx : U256) (j : U256) (pkx : U256) (pky : U256) (c1x : U256) (c1y : U256) (c2x : U256) (c2y : U256) (a0x : U256) (a0y : U256) (b0x : U256) (b0y : U256) (a1x : U256) (a1y : U256) (b1x : U256) (b1y : U256) => hash (hash (hash (hash (hash (hash (hash (hash (hash (hash (hash (hash (hash (hash (hash (hash onehotTag ctx) j) pkx) pky) c1x) c1y) c2x) c2y) a0x) a0y) b0x) b0y) a1x) a1y) b1x) b1y

