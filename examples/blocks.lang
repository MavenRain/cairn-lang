-- Env.block (slice S8, O17 guest side, Q4 (b)): the entry stamp stores the
-- block number of the call. `langc run` takes it from the BLOCK column of a
-- call (NOW BLOCK CALLER NAME ARGS...). The EVM form (NUMBER) is slice S10.
state State := makeState (seen : U256)
def init : State := makeState 0u

def stamp : (env : Env) -> (s : State) -> Option (Prod State (List Out)) :=
  fun (env : Env) (s : State) => some (pair (makeState (block env)) nil)
