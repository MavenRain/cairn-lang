  fun (s : State) (n : U256) (a0 : Prod U256 U256) (b0 : Prod U256 U256) (a1 : Prod U256 U256) (b1 : Prod U256 U256) => makeState (mapSet (used s) n flagYes) (pend s) (stage s) (first a0) (second a0) (first b0) (second b0) (first a1) (second a1) (first b1) (second b1) (u256Add (casts s) 1u) (castEnd s) (proposal s) (window s) (enacted s) (keys s) (fills s) (u256Add (seq s) 1u)

-- Entry castSeal (7 words): N not used, both slot flags, seq <= castEnd, the sum proof on the kept slots, then the tally add.
def castSeal : (env : Env) -> (s : State) -> (ix : U256) -> (iy : U256) -> (ax : U256) -> (ay : U256) -> (bx : U256) -> (by : U256) -> (z : U256) -> Option (Prod State (List Out)) :=
  fun (env : Env) (s : State) (ix : U256) (iy : U256) (ax : U256) (ay : U256) (bx : U256) (by : U256) (z : U256) => flagIf (mapGet (used s) (nullOf ix iy)) none (flagIf (u256Eq (mapGet (stage s) (nullOf ix iy)) 1u) (flagIf (u256Eq (mapGet (stage s) (hash (nullOf ix iy) 0u)) 1u) (flagIf (u256Eq (mapGet (stage s) (hash (nullOf ix iy) 1u)) 1u) (flagIf (u256Le (seq s) (castEnd s)) (flagIf (sumWith (ctxOf ix iy) (ecAdd (kept (pend s) (nullOf ix iy) 0u) (kept (pend s) (nullOf ix iy) 4u)) (ecAdd (kept (pend s) (nullOf ix iy) 2u) (kept (pend s) (nullOf ix iy) 6u)) ax ay bx by z) (some (pair (afterSeal s (nullOf ix iy) (ecAdd (pair (t0ax s) (t0ay s)) (kept (pend s) (nullOf ix iy) 0u)) (ecAdd (pair (t0bx s) (t0by s)) (kept (pend s) (nullOf ix iy) 2u)) (ecAdd (pair (t1ax s) (t1ay s)) (kept (pend s) (nullOf ix iy) 4u)) (ecAdd (pair (t1bx s) (t1by s)) (kept (pend s) (nullOf ix iy) 6u))) nil)) none) none) none) none) none)

-- The reactor contract (examples/reactor.lang, S10R): its entry transfer sets its window when the caller is
-- this DAO (Q-S11-2 (a)). The window after enactKit: the proposal when yes = m > no = casts - m.
def reactor : Addr := 0x0000000000000000000000000072656163746f72

def nextWindow : (s : State) -> (m : U256) -> U256 :=
  fun (s : State) (m : U256) => flagIf (u256Le m (u256Sub (casts s) m)) (window s) (proposal s)

-- The event of enactKit (S5 O15): the reactor and the new window.
event Enacted (target : Addr) (window : U256)

-- Entry enactKit (15 words): seq > castEnd, not enacted, m <= casts, the opening of T0 (two DLEQ shares of {1, 2}),
-- then the window moves to nextWindow, enacted is set, and the event Enacted logs the reactor and the new
-- window (S5 O15: Out has no token transfer).
def enactKit : (env : Env) -> (s : State) -> (d1x : U256) -> (d1y : U256) -> (a1x : U256) -> (a1y : U256) -> (b1x : U256) -> (b1y : U256) -> (z1 : U256) -> (d2x : U256) -> (d2y : U256) -> (a2x : U256) -> (a2y : U256) -> (b2x : U256) -> (b2y : U256) -> (z2 : U256) -> (m : U256) -> Option (Prod State (List Out)) :=
  fun (env : Env) (s : State) (d1x : U256) (d1y : U256) (a1x : U256) (a1y : U256) (b1x : U256) (b1y : U256) (z1 : U256) (d2x : U256) (d2y : U256) (a2x : U256) (a2y : U256) (b2x : U256) (b2y : U256) (z2 : U256) (m : U256) => flagIf (u256Le (seq s) (castEnd s)) none (flagIf (enacted s) none (flagIf (u256Le m (casts s)) (flagIf (openSum (pair (t0ax s) (t0ay s)) (pair (t0bx s) (t0by s)) (t0ax s) (t0ay s) (t0bx s) (t0by s) d1x d1y a1x a1y b1x b1y z1 d2x d2y a2x a2y b2x b2y z2 m) (some (pair (makeState (used s) (pend s) (stage s) (t0ax s) (t0ay s) (t0bx s) (t0by s) (t1ax s) (t1ay s) (t1bx s) (t1by s) (casts s) (castEnd s) (proposal s) (nextWindow s m) flagYes (keys s) (fills s) (u256Add (seq s) 1u)) (cons (Enacted reactor (nextWindow s m)) nil))) none) none))

-- Views: the tally word k (T0 c1x c1y c2x c2y, then T1), the window, the casts, the stage of N (1 castSig, + 2 slot 0, + 4 slot 1).
def tallyWord : (env : Env) -> (s : State) -> (k : U256) -> U256 :=
  fun (env : Env) (s : State) (k : U256) => flagIf (u256Eq k 0u) (t0ax s) (flagIf (u256Eq k 1u) (t0ay s) (flagIf (u256Eq k 2u) (t0bx s) (flagIf (u256Eq k 3u) (t0by s) (flagIf (u256Eq k 4u) (t1ax s) (flagIf (u256Eq k 5u) (t1ay s) (flagIf (u256Eq k 6u) (t1bx s) (t1by s)))))))

def windowNow : (env : Env) -> (s : State) -> U256 := fun (env : Env) (s : State) => window s

def castCount : (env : Env) -> (s : State) -> U256 := fun (env : Env) (s : State) => casts s

def stageOf : (env : Env) -> (s : State) -> (ix : U256) -> (iy : U256) -> U256 :=
  fun (env : Env) (s : State) (ix : U256) (iy : U256) => u256Add (mapGet (stage s) (nullOf ix iy)) (u256Add (u256Add (mapGet (stage s) (hash (nullOf ix iy) 0u)) (mapGet (stage s) (hash (nullOf ix iy) 0u))) (u256Add (u256Add (mapGet (stage s) (hash (nullOf ix iy) 1u)) (mapGet (stage s) (hash (nullOf ix iy) 1u))) (u256Add (mapGet (stage s) (hash (nullOf ix iy) 1u)) (mapGet (stage s) (hash (nullOf ix iy) 1u)))))

-- Eval rows (test/eval/expect.txt): the 3 casts (ops 1 to 12), one more op (reslot), then enactKit at seq 13 > castEnd.
def e0 : Env := makeEnv 0x00000000000000000000000000000000000000aa

def v0sig : Option (Prod State (List Out)) :=
  castSig e0 init b0ix b0iy b0j0c1x b0j0c1y b0j0c2x b0j0c2y b0j1c1x b0j1c1y b0j1c2x b0j1c2y b0c1 b0s1 b0s2 b0s3

def v0slots : Option (Prod State (List Out)) :=
  bind v0sig (fun (r : Prod State (List Out)) => bind (castSlot e0 (first r) b0ix b0iy 0u b0j0a0x b0j0a0y b0j0b0x b0j0b0y b0j0a1x b0j0a1y b0j0b1x b0j0b1y b0j0e0 b0j0e1 b0j0z0 b0j0z1) (fun (q : Prod State (List Out)) => castSlot e0 (first q) b0ix b0iy 1u b0j1a0x b0j1a0y b0j1b0x b0j1b0y b0j1a1x b0j1a1y b0j1b1x b0j1b1y b0j1e0 b0j1e1 b0j1z0 b0j1z1))

def v0 : Option (Prod State (List Out)) :=
  bind v0slots (fun (r : Prod State (List Out)) => castSeal e0 (first r) b0ix b0iy b0sumax b0sumay b0sumbx b0sumby b0sumz)

def v1 : Option (Prod State (List Out)) :=
  bind v0 (fun (r : Prod State (List Out)) => bind (castSig e0 (first r) b1ix b1iy b1j0c1x b1j0c1y b1j0c2x b1j0c2y b1j1c1x b1j1c1y b1j1c2x b1j1c2y b1c1 b1s1 b1s2 b1s3) (fun (a : Prod State (List Out)) => bind (castSlot e0 (first a) b1ix b1iy 0u b1j0a0x b1j0a0y b1j0b0x b1j0b0y b1j0a1x b1j0a1y b1j0b1x b1j0b1y b1j0e0 b1j0e1 b1j0z0 b1j0z1) (fun (b : Prod State (List Out)) => bind (castSlot e0 (first b) b1ix b1iy 1u b1j1a0x b1j1a0y b1j1b0x b1j1b0y b1j1a1x b1j1a1y b1j1b1x b1j1b1y b1j1e0 b1j1e1 b1j1z0 b1j1z1) (fun (c : Prod State (List Out)) => castSeal e0 (first c) b1ix b1iy b1sumax b1sumay b1sumbx b1sumby b1sumz))))

def v2slots : Option (Prod State (List Out)) :=
  bind v1 (fun (r : Prod State (List Out)) => bind (castSig e0 (first r) b2ix b2iy b2j0c1x b2j0c1y b2j0c2x b2j0c2y b2j1c1x b2j1c1y b2j1c2x b2j1c2y b2c1 b2s1 b2s2 b2s3) (fun (a : Prod State (List Out)) => bind (castSlot e0 (first a) b2ix b2iy 0u b2j0a0x b2j0a0y b2j0b0x b2j0b0y b2j0a1x b2j0a1y b2j0b1x b2j0b1y b2j0e0 b2j0e1 b2j0z0 b2j0z1) (fun (b : Prod State (List Out)) => castSlot e0 (first b) b2ix b2iy 1u b2j1a0x b2j1a0y b2j1b0x b2j1b0y b2j1a1x b2j1a1y b2j1b1x b2j1b1y b2j1e0 b2j1e1 b2j1z0 b2j1z1)))

def v2 : Option (Prod State (List Out)) :=
  bind v2slots (fun (c : Prod State (List Out)) => castSeal e0 (first c) b2ix b2iy b2sumax b2sumay b2sumbx b2sumby b2sumz)

-- One more op: voter 2 casts slot 1 again. The state keeps its words; only seq moves.
def reslot : (s : State) -> Option (Prod State (List Out)) :=
  fun (s : State) => castSlot e0 s b2ix b2iy 1u b2j1a0x b2j1a0y b2j1b0x b2j1b0y b2j1a1x b2j1a1y b2j1b1x b2j1b1y b2j1e0 b2j1e1 b2j1z0 b2j1z1

def v2late : Option (Prod State (List Out)) :=
  bind v2 (fun (r : Prod State (List Out)) => reslot (first r))

def openWith : (m : U256) -> (env : Env) -> (s : State) -> Option (Prod State (List Out)) :=
  fun (m : U256) (env : Env) (s : State) => enactKit env s tyd1x tyd1y tya1x tya1y tyb1x tyb1y tyz1 tyd2x tyd2y tya2x tya2y tyb2x tyb2y tyz2 m

def stageSig : Option U256 :=
  map (fun (r : Prod State (List Out)) => stageOf e0 (first r) b0ix b0iy) v0sig

def stageSlots : Option U256 :=
  map (fun (r : Prod State (List Out)) => stageOf e0 (first r) b0ix b0iy) v0slots

def tallyHost : Option Flag :=
  map (fun (r : Prod State (List Out)) => flagIf (u256Eq (tallyWord e0 (first r) 0u) tyc1x) (flagIf (u256Eq (tallyWord e0 (first r) 1u) tyc1y) (flagIf (u256Eq (tallyWord e0 (first r) 2u) tyc2x) (u256Eq (tallyWord e0 (first r) 3u) tyc2y) flagNo) flagNo) flagNo) v2

def castsAfter : Option U256 := map (fun (r : Prod State (List Out)) => castCount e0 (first r)) v2

def recast : Option (Prod State (List Out)) :=
  bind v0 (fun (r : Prod State (List Out)) => castSig e0 (first r) b0ix b0iy b0j0c1x b0j0c1y b0j0c2x b0j0c2y b0j1c1x b0j1c1y b0j1c2x b0j1c2y b0c1 b0s1 b0s2 b0s3)

def sealEarly : Option (Prod State (List Out)) :=
  bind v0sig (fun (r : Prod State (List Out)) => castSeal e0 (first r) b0ix b0iy b0sumax b0sumay b0sumbx b0sumby b0sumz)

-- sealLate: two more ops after the slots of voter 2, so its castSeal comes at seq 13 > castEnd 12.
def sealLate : Option (Prod State (List Out)) :=
  bind (bind v2slots (fun (r : Prod State (List Out)) => reslot (first r))) (fun (a : Prod State (List Out)) => bind (reslot (first a)) (fun (b : Prod State (List Out)) => castSeal e0 (first b) b2ix b2iy b2sumax b2sumay b2sumbx b2sumby b2sumz))

-- enactEarly: enactKit at seq 12 (not > castEnd 12).
def enactEarly : Option (Prod State (List Out)) :=
  bind v2 (fun (r : Prod State (List Out)) => openWith 2u e0 (first r))

def enactM3 : Option (Prod State (List Out)) :=
  bind v2late (fun (r : Prod State (List Out)) => openWith 3u e0 (first r))

def windowAfter : Option U256 :=
  map (fun (q : Prod State (List Out)) => windowNow e0 (first q)) (bind v2late (fun (r : Prod State (List Out)) => openWith 2u e0 (first r)))

def enactPay : Option (List Out) :=
  map (fun (q : Prod State (List Out)) => second q) (bind v2late (fun (r : Prod State (List Out)) => openWith 2u e0 (first r)))

def enactTwice : Option (Prod State (List Out)) :=
  bind (bind v2late (fun (r : Prod State (List Out)) => openWith 2u e0 (first r))) (fun (q : Prod State (List Out)) => openWith 2u e0 (first q))
