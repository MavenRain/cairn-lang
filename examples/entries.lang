-- Entries: first-order Nat and Flag definitions. The target exports them.
def addPrice : (a : Nat) -> (b : Nat) -> Nat := fun (a : Nat) (b : Nat) => natAdd a b

def ratio : (a : Nat) -> (k : Nat) -> Nat := fun (a : Nat) (k : Nat) => natDiv a k

def remainder : (a : Nat) -> (k : Nat) -> Nat := fun (a : Nat) (k : Nat) => natMod a k

def discount : (a : Nat) -> (d : Nat) -> Nat := fun (a : Nat) (d : Nat) => natSub a d

def cheap : (a : Nat) -> Flag := fun (a : Nat) => natLe a 100

def square : (n : Nat) -> Nat := fun (n : Nat) => fold (fun (acc : Nat) => natAdd acc n) 0 n

def pick : (f : Flag) -> (a : Nat) -> (b : Nat) -> Nat :=
  fun (f : Flag) (a : Nat) (b : Nat) => flagIf f a b
