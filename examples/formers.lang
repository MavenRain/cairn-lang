-- Formers F1 to F4: products, sums, options and lists (FreeMon since S3).
def price : Nat := 1200
def both : Prod Nat Flag := pair price flagYes
def left : Nat := first both
def right : Flag := second both
def size : (n : Nat) -> Nat := fun (n : Nat) => natAdd n 1
def count : (n : Nat) -> Nat := fun (n : Nat) => n
def choice : Sum Nat Nat := inr 5
def picked : Nat := either size count choice
def nothing : Option Nat := none
def something : Option Nat := some 7
def orZero : (o : Option Nat) -> Nat := fun (o : Option Nat) => option 0 (fun (n : Nat) => n) o
def xs : FreeMon Nat := fmCons Nat 1 (fmCons Nat 2 (fmCons Nat 3 (fmUnit Nat)))
def empty : FreeMon Nat := fmUnit Nat
