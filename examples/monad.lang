-- Formers F5 and F8: pure, map and bind over Option, Sum E and lists; filter.
-- The list rows use FreeMon (S3): fmEta is pure, fmBind is bind, and the
-- filter of a list is a bind.
def lifted : Option Nat := map (fun (n : Nat) => natAdd n 1) (some 4)

def chained : Option Nat := bind (some 4) (fun (n : Nat) => some (natAdd n n))

def single : FreeMon Nat := fmEta Nat 5

def wrapped : Option Nat := pure 5

def okRight : Sum Flag Nat := map (fun (n : Nat) => natAdd n 1) (inr 3)

def okBind : Sum Flag Nat := bind (inr 3) (fun (n : Nat) => inl flagNo)

def doubled : FreeMon Nat :=
  fmBind Nat Nat (fun (x : Nat) => fmCons Nat x (fmCons Nat x (fmUnit Nat))) (fmCons Nat 1 (fmCons Nat 2 (fmUnit Nat)))

def small : FreeMon Nat :=
  fmBind Nat Nat (fun (n : Nat) => flagIf (natLe n 2) (fmEta Nat n) (fmUnit Nat)) (fmCons Nat 1 (fmCons Nat 2 (fmCons Nat 3 (fmUnit Nat))))

def kept : Option Nat := filter (fun (n : Nat) => natEq n 4) (some 4)
