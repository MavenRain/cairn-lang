-- Host ecAdd and ecMul on the secp256k1 group (S4, SEC 2): a closed curve op computes in the evaluator (front/secp256k1.c).
-- k G for k in 1, 2, 3, r minus 1 and r, with G the SEC 2 generator and r its order n.
-- A coordinate at or above p, or a point not on the curve, traps (R14, R18).

def p : U256 := 0xfffffffffffffffffffffffffffffffffffffffffffffffffffffffefffffc2fu
def pMinusGy : U256 := 0xb7c52588d95c3b9aa25b0403f1eef75702e84bb7597aabe663b82f6f04ef2777u
def pPlusTwo : U256 := 0xfffffffffffffffffffffffffffffffffffffffffffffffffffffffefffffc31u
def r : U256 := 0xfffffffffffffffffffffffffffffffebaaedce6af48a03bbfd25e8cd0364141u
def rMinusOne : U256 := 0xfffffffffffffffffffffffffffffffebaaedce6af48a03bbfd25e8cd0364140u

def oneG : Prod U256 U256 := ecMul (pair 0x79be667ef9dcbbac55a06295ce870b07029bfcdb2dce28d959f2815b16f81798u 0x483ada7726a3c4655da4fbfc0e1108a8fd17b448a68554199c47d08ffb10d4b8u) 1u
def twoG : Prod U256 U256 := ecMul (pair 0x79be667ef9dcbbac55a06295ce870b07029bfcdb2dce28d959f2815b16f81798u 0x483ada7726a3c4655da4fbfc0e1108a8fd17b448a68554199c47d08ffb10d4b8u) 2u
def threeG : Prod U256 U256 := ecMul (pair 0x79be667ef9dcbbac55a06295ce870b07029bfcdb2dce28d959f2815b16f81798u 0x483ada7726a3c4655da4fbfc0e1108a8fd17b448a68554199c47d08ffb10d4b8u) 3u
def rMinusOneG : Prod U256 U256 := ecMul (pair 0x79be667ef9dcbbac55a06295ce870b07029bfcdb2dce28d959f2815b16f81798u 0x483ada7726a3c4655da4fbfc0e1108a8fd17b448a68554199c47d08ffb10d4b8u) rMinusOne

-- r is the order of G, so r G is the point at infinity, (0, 0).
def rG : Prod U256 U256 := ecMul (pair 0x79be667ef9dcbbac55a06295ce870b07029bfcdb2dce28d959f2815b16f81798u 0x483ada7726a3c4655da4fbfc0e1108a8fd17b448a68554199c47d08ffb10d4b8u) r

-- (Gx, p minus Gy) is the negation of G, so the sum is the point at infinity.
def negSum : Prod U256 U256 := ecAdd (pair 0x79be667ef9dcbbac55a06295ce870b07029bfcdb2dce28d959f2815b16f81798u 0x483ada7726a3c4655da4fbfc0e1108a8fd17b448a68554199c47d08ffb10d4b8u) (pair 0x79be667ef9dcbbac55a06295ce870b07029bfcdb2dce28d959f2815b16f81798u pMinusGy)

-- Each trap row is an entry (Nat -> Flag, as eqTrap in words.lang), so `langc eval` gives the EVAL_OVERFLOW line.
-- (1, 1) is not on the curve.
def addBad : Nat -> Flag := fun (n : Nat) => u256Eq (first (ecAdd (pair 1u 1u) (pair 1u (toU256 n)))) 0u
def mulBad : Nat -> Flag := fun (n : Nat) => u256Eq (first (ecMul (pair 1u 1u) (toU256 n))) 0u

-- A coordinate at or above p traps: (p, 2) and (1, p + 2).
def coordP : Nat -> Flag := fun (n : Nat) => u256Eq (first (ecAdd (pair p 2u) (pair 1u (toU256 n)))) 0u
def coordBig : Nat -> Flag := fun (n : Nat) => u256Eq (first (ecMul (pair 1u pPlusTwo) (toU256 n))) 0u
