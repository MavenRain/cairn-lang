-- The threshold opening on the chain (S6, Q-S6-6 and Q-S6-7 (a)). A kit file:
-- word literals and word ops are kit items. Each constant comes from the
-- host (`build/thresholdtool words`: n 3, t 2, m 1234, quorum {1, 2}), and
-- test/precompile.sh deploys this contract after precompile.lang.
-- dleqOk checks one Chaum-Pedersen proof (A, B, z) that D = s C1 for the
-- share key PK = s G: e is the hash chain from dleqTag ("dleq") over PK, C1,
-- D, A and B (a raw word, as the host), then z G = A + e PK and
-- z C1 = B + e D. combineX and combineY give K = l1 D1 + l2 D2 (t = 2). The
-- Lagrange coefficients are hints that the chain does not check in S6
-- (Q-S6-7). openOk checks C2 = m G + K: the opener gives m, the BSGS stays
-- off the chain.
state State := makeState (opened : Nat)

def init : State := makeState 0

def dleqTag : U256 := 1684825457u

def challenge : (pkx : U256) -> (pky : U256) -> (cx : U256) -> (cy : U256) -> (dx : U256) -> (dy : U256) -> (ax : U256) -> (ay : U256) -> (bx : U256) -> (by : U256) -> U256 :=
  fun (pkx : U256) (pky : U256) (cx : U256) (cy : U256) (dx : U256) (dy : U256) (ax : U256) (ay : U256) (bx : U256) (by : U256) => hash (hash (hash (hash (hash (hash (hash (hash (hash (hash dleqTag pkx) pky) cx) cy) dx) dy) ax) ay) bx) by

def pointEq : (p : Prod U256 U256) -> (q : Prod U256 U256) -> Flag :=
  fun (p : Prod U256 U256) (q : Prod U256 U256) => flagIf (u256Eq (first p) (first q)) (u256Eq (second p) (second q)) flagNo

def dleqWith : (pkx : U256) -> (pky : U256) -> (cx : U256) -> (cy : U256) -> (dx : U256) -> (dy : U256) -> (ax : U256) -> (ay : U256) -> (bx : U256) -> (by : U256) -> (z : U256) -> (e : U256) -> Flag :=
  fun (pkx : U256) (pky : U256) (cx : U256) (cy : U256) (dx : U256) (dy : U256) (ax : U256) (ay : U256) (bx : U256) (by : U256) (z : U256) (e : U256) => flagIf (pointEq (ecMul (pair 0x79be667ef9dcbbac55a06295ce870b07029bfcdb2dce28d959f2815b16f81798u 0x483ada7726a3c4655da4fbfc0e1108a8fd17b448a68554199c47d08ffb10d4b8u) z) (ecAdd (pair ax ay) (ecMul (pair pkx pky) e))) (pointEq (ecMul (pair cx cy) z) (ecAdd (pair bx by) (ecMul (pair dx dy) e))) flagNo

def dleq : (pkx : U256) -> (pky : U256) -> (cx : U256) -> (cy : U256) -> (dx : U256) -> (dy : U256) -> (ax : U256) -> (ay : U256) -> (bx : U256) -> (by : U256) -> (z : U256) -> Flag :=
  fun (pkx : U256) (pky : U256) (cx : U256) (cy : U256) (dx : U256) (dy : U256) (ax : U256) (ay : U256) (bx : U256) (by : U256) (z : U256) => dleqWith pkx pky cx cy dx dy ax ay bx by z (challenge pkx pky cx cy dx dy ax ay bx by)

def opens : (ux : U256) -> (uy : U256) -> (vx : U256) -> (vy : U256) -> (n : U256) -> Flag :=
  fun (ux : U256) (uy : U256) (vx : U256) (vy : U256) (n : U256) => pointEq (pair ux uy) (ecAdd (ecMul (pair 0x79be667ef9dcbbac55a06295ce870b07029bfcdb2dce28d959f2815b16f81798u 0x483ada7726a3c4655da4fbfc0e1108a8fd17b448a68554199c47d08ffb10d4b8u) n) (pair vx vy))

-- One DLEQ proof: 4 ecMul, 2 ecAdd, 10 hash.
def dleqOk : (env : Env) -> (s : State) -> (pkx : U256) -> (pky : U256) -> (cx : U256) -> (cy : U256) -> (dx : U256) -> (dy : U256) -> (ax : U256) -> (ay : U256) -> (bx : U256) -> (by : U256) -> (z : U256) -> Flag :=
  fun (env : Env) (s : State) (pkx : U256) (pky : U256) (cx : U256) (cy : U256) (dx : U256) (dy : U256) (ax : U256) (ay : U256) (bx : U256) (by : U256) (z : U256) => dleq pkx pky cx cy dx dy ax ay bx by z

-- K = l1 D1 + l2 D2: 2 ecMul, 1 ecAdd.
def combineX : (env : Env) -> (s : State) -> (ux : U256) -> (uy : U256) -> (l : U256) -> (vx : U256) -> (vy : U256) -> (k : U256) -> U256 :=
  fun (env : Env) (s : State) (ux : U256) (uy : U256) (l : U256) (vx : U256) (vy : U256) (k : U256) => first (ecAdd (ecMul (pair ux uy) l) (ecMul (pair vx vy) k))

def combineY : (env : Env) -> (s : State) -> (ux : U256) -> (uy : U256) -> (l : U256) -> (vx : U256) -> (vy : U256) -> (k : U256) -> U256 :=
  fun (env : Env) (s : State) (ux : U256) (uy : U256) (l : U256) (vx : U256) (vy : U256) (k : U256) => second (ecAdd (ecMul (pair ux uy) l) (ecMul (pair vx vy) k))

-- C2 = m G + K: 1 ecMul, 1 ecAdd.
def openOk : (env : Env) -> (s : State) -> (ux : U256) -> (uy : U256) -> (vx : U256) -> (vy : U256) -> (n : U256) -> Flag :=
  fun (env : Env) (s : State) (ux : U256) (uy : U256) (vx : U256) (vy : U256) (n : U256) => opens ux uy vx vy n

-- The host words (closed: the evaluator computes the curve ops and hashes).
