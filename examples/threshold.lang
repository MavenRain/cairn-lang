def dleqGood : Flag := dleq pk1x pk1y c1x c1y d1x d1y a1x a1y b1x b1y z1

def dleqBad : Flag := dleq pk1x pk1y c1x c1y d1x d1y a1x a1y b1x b1y z1bad

def openGood : Flag := opens c2x c2y kx ky m

def openBad : Flag := opens c2x c2y kx ky 1235u
