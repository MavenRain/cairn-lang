-- A fold over the block of Charter and Ratified needs a case for each
-- constructor of each sort. This fold has no ratifiedSquash case, so the
-- target of Ratified has no isSet proof (S6, a missing coherence case in
-- a block).
def f : Charter -> Trunc0 Size :=
  fun (c : Charter) => fold (Trunc0 Size) (Trunc0 Size) (trunc0 Size sz0) (fun (b : Trunc0 Size) (r : Trunc0 Size) => trunc0 Size (szS sz0)) (fun (b : Trunc0 Size) (w : Size) (i : I) => trunc0 Size (szS sz0)) (fun (x : Trunc0 Size) (y : Trunc0 Size) (p : Path (Trunc0 Size) x y) (q : Path (Trunc0 Size) x y) (i : I) (j : I) => squash0 Size x y p q i j) (fun (b : Trunc0 Size) (w : Size) => b) c
