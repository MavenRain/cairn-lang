-- A constitution carries the invariance proof of its rule. The rule gives the choice of member inl unit, and the flip
-- act changes that choice, so refl is not its invariance proof: the refl end site refuses it.
def Member : Type 0 := Sum Unit Unit
def Choice : Type 0 := Sum Unit Unit
def Outcome : Type 0 := Trunc0 Choice
def Group : Type 0 := Sum Unit Unit
def flip : Choice -> Choice := fun (c : Choice) => either (fun (u : Unit) => inr unit) (fun (u : Unit) => inl unit) c
def act : Group -> (Member -> Choice) -> Member -> Choice :=
  fun (g : Group) (f : Member -> Choice) (m : Member) => either (fun (u : Unit) => f m) (fun (u : Unit) => flip (f m)) g
def outcomeSet : isSet Outcome := fun (x : Outcome) (y : Outcome) (p : Path Outcome x y) (q : Path Outcome x y) => fun (i : I) => fun (j : I) => squash0 Choice x y p q i j
def firstCon : Constitution := pack (fun (c : Config) => trunc0 Choice (c (inl unit))) (fun (g : Group) (c : Config) => refl)
