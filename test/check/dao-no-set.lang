-- The kernel gives the DAO prelude only after outcomeSet. This program has act and no outcomeSet, so the name aggregate is unknown.
def Member : Type 0 := Sum Unit Unit

def Choice : Type 0 := Sum Unit Unit

def Outcome : Type 0 := Choice

def Group : Type 0 := Sum Unit Unit

def flip : Choice -> Choice :=
  fun (c : Choice) => either (fun (u : Unit) => inr unit) (fun (u : Unit) => inl unit) c

def act : Group -> (Member -> Choice) -> Member -> Choice :=
  fun (g : Group) (f : Member -> Choice) (m : Member) => either (fun (u : Unit) => f m) (fun (u : Unit) => flip (f m)) g

def bad : (Orbit -> Outcome) -> Orbit -> Outcome := fun (L : Orbit -> Outcome) => aggregate (gov L)
