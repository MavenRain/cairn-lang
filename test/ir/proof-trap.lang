-- Proofs that trap. `evidence n` traps at n = 18446744073709551615 (natAdd
-- overflows), and each entry reads its path at i1, so the trap reaches the
-- result. At other n each entry gives 7.
def evidence : Nat -> Path Nat 0 0 := fun n => flagIf (natEq (natAdd n 1) 0) refl refl

def proofMove : Nat -> Nat := fun n => natAdd (evidence n @ i1) 7

def proofSymm : Nat -> Nat := fun n => natAdd (sym (evidence n) @ i1) 7

def baseProof : Path Nat 0 0 := refl

def proofTrans : Nat -> Nat := fun n => natAdd (trans Nat 0 0 0 baseProof (evidence n) @ i1) 7

def proofCong : Nat -> Nat := fun n => natAdd (cong (fun (x : Nat) => x) (evidence n) @ i1) 7
