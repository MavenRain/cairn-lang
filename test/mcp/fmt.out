{"jsonrpc":"2.0","id":2,"result":{"content":[{"type":"text","text":"-- Entries: first-order Nat and Flag definitions. The target exports them.\ndef addPrice : (a : Nat) -> (b : Nat) -> Nat := fun (a : Nat) (b : Nat) => natAdd a b\n\ndef ratio : (a : Nat) -> (k : Nat) -> Nat := fun (a : Nat) (k : Nat) => natDiv a k\n\ndef remainder : (a : Nat) -> (k : Nat) -> Nat := fun (a : Nat) (k : Nat) => natMod a k\n\ndef discount : (a : Nat) -> (d : Nat) -> Nat := fun (a : Nat) (d : Nat) => natSub a d\n\ndef cheap : (a : Nat) -> Flag := fun (a : Nat) => natLe a 100\n\ndef square : (n : Nat) -> Nat := fun (n : Nat) => fold (fun (acc : Nat) => natAdd acc n) 0 n\n\ndef pick : (f : Flag) -> (a : Nat) -> (b : Nat) -> Nat :=\n  fun (f : Flag) (a : Nat) (b : Nat) => flagIf f a b\n"}],"isError":false}}
