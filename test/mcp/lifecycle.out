{"jsonrpc":"2.0","id":2,"result":{"tools":[{"name":"check","description":"Checks the cairn-lang program at path. The text is the langc check --json line.","inputSchema":{"type":"object","properties":{"path":{"type":"string"}},"required":["path"]}},{"name":"fmt","description":"Gives the canonical text of the cairn-lang program at path, as langc fmt.","inputSchema":{"type":"object","properties":{"path":{"type":"string"}},"required":["path"]}},{"name":"eval","description":"Evaluates the definition name of the cairn-lang program at path with args, as langc eval.","inputSchema":{"type":"object","properties":{"path":{"type":"string"},"name":{"type":"string"},"args":{"type":"array","items":{"type":"string"}}},"required":["path","name"]}},{"name":"build","description":"Writes the target module of the cairn-lang program at path to the file out, as langc build.","inputSchema":{"type":"object","properties":{"path":{"type":"string"},"target":{"type":"string","enum":["main","runtime","js","wgsl"]},"out":{"type":"string"}},"required":["path","target","out"]}},{"name":"explain","description":"Gives the meaning and the docs/host/README.md section of a refusal code, as langc explain.","inputSchema":{"type":"object","properties":{"code":{"type":"string"}},"required":["code"]}}]}}
