def addX : (a : U256) -> (b : U256) -> (c : U256) -> (d : U256) -> U256 :=
  fun (a : U256) (b : U256) (c : U256) (d : U256) => first (ecAdd (pair a b) (pair c d))

def addY : (a : U256) -> (b : U256) -> (c : U256) -> (d : U256) -> U256 :=
  fun (a : U256) (b : U256) (c : U256) (d : U256) => second (ecAdd (pair a b) (pair c d))

def mulX : (x : U256) -> (y : U256) -> (k : U256) -> U256 :=
  fun (x : U256) (y : U256) (k : U256) => first (ecMul (pair x y) k)

def mulY : (x : U256) -> (y : U256) -> (k : U256) -> U256 :=
  fun (x : U256) (y : U256) (k : U256) => second (ecMul (pair x y) k)

def sigOk : (k : U256) -> (r : U256) -> (z : U256) -> (m : U256) -> (e : U256) -> Flag :=
  fun (k : U256) (r : U256) (z : U256) (m : U256) (e : U256) => schnorrOk k r z m e
